datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

model persona {
  id                   BigInt    @id @default(autoincrement())
  dni                  String
  nombre               String
  apellidoPaterno      String
  apellidoMaterno      String
  email                String?
  fechaRegistro        DateTime? @default(now()) @map("fecha_registro") @db.Timestamptz
  usuarioRegistro      String?   @map("usuario_registro")
  fechaActualizacion   DateTime? @map("fecha_actualizacion") @db.Timestamptz
  usuarioActualizacion String?   @map("usuario_actualizacion")
}

// ============================================
// MÓDULO: UBIGEO
// ============================================

model ubigeos {
  id          String  @id @default(uuid()) @db.Uuid
  codigo      String  @unique @db.VarChar(8)
  tipo        String? @db.VarChar(50)
  nombre      String? @db.VarChar(100)
  codigoPadre String? @map("codigo_padre") @db.VarChar(8)
  activo      Boolean @default(true)
}

// ============================================
// MÓDULO: ENUMERADOS
// ============================================

model enumerados {
  id          String  @id @default(uuid()) @db.Uuid
  tipo        String  @db.VarChar(50)
  codigo      String  @db.VarChar(50)
  valor       String  @db.VarChar(100)
  descripcion String? @db.Text
  orden       Int     @default(0)
  color       String? @db.VarChar(20)
  icono       String? @db.VarChar(50)
  metadata    Json?   @db.JsonB
  activo      Boolean @default(true)

  @@unique([tipo, codigo], name: "uq_enumerado_tipo_codigo")
}

// ============================================
// MÓDULO: USUARIOS - TIENDAS (Multi-tenant)
// ============================================

model usuario_tiendas {
  id       String  @id @default(uuid()) @db.Uuid
  userId   String  @map("user_id") @db.Uuid // ID del usuario de Supabase Auth
  tiendaId String  @map("tienda_id") @db.Uuid
  rol      String  @default("viewer") @db.VarChar(50) // owner, admin, editor, viewer
  activo   Boolean @default(true)

  // Auditoría
  fechaRegistro        DateTime? @default(now()) @map("fecha_registro") @db.Timestamptz
  usuarioRegistro      String?   @map("usuario_registro") @db.VarChar(100)
  fechaActualizacion   DateTime? @map("fecha_actualizacion") @db.Timestamptz
  usuarioActualizacion String?   @map("usuario_actualizacion") @db.VarChar(100)

  // Relación con tienda
  tienda tiendas @relation(fields: [tiendaId], references: [id])

  @@unique([userId, tiendaId], name: "uq_usuario_tienda")
}

model invitaciones {
  id              String   @id @default(uuid()) @db.Uuid
  tiendaId        String   @map("tienda_id") @db.Uuid
  email           String   @db.VarChar(100)
  rol             String   @default("viewer") @db.VarChar(50) // owner, admin, editor, viewer
  token           String   @unique @db.VarChar(100)
  estado          String   @default("pendiente") @db.VarChar(20) // pendiente, aceptada, expirada, cancelada
  fechaExpiracion DateTime @map("fecha_expiracion") @db.Timestamptz
  mensaje         String?  @db.Text

  // Auditoría
  fechaRegistro        DateTime? @default(now()) @map("fecha_registro") @db.Timestamptz
  usuarioRegistro      String?   @map("usuario_registro") @db.VarChar(100)
  fechaActualizacion   DateTime? @map("fecha_actualizacion") @db.Timestamptz
  usuarioActualizacion String?   @map("usuario_actualizacion") @db.VarChar(100)

  // Relación con tienda
  tienda tiendas @relation(fields: [tiendaId], references: [id])

  @@index([email], name: "idx_invitacion_email")
  @@index([tiendaId], name: "idx_invitacion_tienda")
}

// ============================================
// MÓDULO: TIENDA
// ============================================

model tiendas {
  id                String   @id @default(uuid()) @db.Uuid
  nombre            String   @db.VarChar(100)
  slug              String   @unique @db.VarChar(100)
  // Idiomas que la tienda eligió ofrecer (códigos de `idiomas`; docs/specs/idiomas).
  // Se publica (y aparece en el selector) al llegar al 100 % de sus textos fijos.
  idiomas           String[] @default(["es"])
  // Idiomas ya publicados (P5 refinada): siguen visibles aunque un deploy agregue
  // textos nuevos; quitar un idioma de `idiomas` lo despublica. Sin el base.
  idiomasPublicados String[] @default([]) @map("idiomas_publicados")
  descripcion       String?  @db.Text
  planId            String?  @map("plan_id") @db.Uuid
  logoUrl           String?  @map("logo_url") @db.VarChar(500)
  logoStoragePath   String?  @map("logo_storage_path") @db.VarChar(500)
  logoBackground    String?  @map("logo_background") @db.VarChar(7)
  bannerUrl         String?  @map("banner_url") @db.VarChar(500)
  bannerStoragePath String?  @map("banner_storage_path") @db.VarChar(500)
  whatsappNumero    String?  @map("whatsapp_numero") @db.VarChar(20)
  email             String?  @db.VarChar(100)
  direccion         String?  @db.Text

  // Datos para facturación electrónica
  ruc             String? @db.VarChar(20)
  razonSocial     String? @map("razon_social") @db.VarChar(200)
  razonComercial  String? @map("razon_comercial") @db.VarChar(200)
  direccionFiscal String? @map("direccion_fiscal") @db.Text
  // false = régimen que solo emite boletas (ej. Nuevo RUS): el checkout no ofrece factura
  emiteFactura    Boolean @default(true) @map("emite_factura")

  // Cobro (docs/specs/pago-automatico R1): manual (captura + verificación) | automatico (pasarela)
  modoPago String @default("manual") @map("modo_pago") @db.VarChar(15)

  // Ubicación
  ubigeo String? @db.VarChar(8)

  // Configuración de envío y marketing
  envioGratisMinimo Decimal? @map("envio_gratis_minimo") @db.Decimal(10, 2)
  metaPixelId       String?  @map("meta_pixel_id") @db.VarChar(50)
  googleAnalyticsId String?  @map("google_analytics_id") @db.VarChar(50)

  // Configuración general
  moneda      String? @default("PEN") @db.VarChar(3)
  // productos | hotel | tours | eventos | locales (CHECK en docs/sql/locales_fase_1.sql)
  tipoNegocio String  @default("productos") @map("tipo_negocio") @db.VarChar(50)
  // Qué vende (moda, alimentos...): sugiere campañas. Valores en modules/tenants/rubros.js
  rubro       String? @db.VarChar(30)
  activo      Boolean @default(true)

  // Auditoría
  fechaRegistro        DateTime? @default(now()) @map("fecha_registro") @db.Timestamptz
  usuarioRegistro      String?   @map("usuario_registro") @db.VarChar(100)
  fechaActualizacion   DateTime? @map("fecha_actualizacion") @db.Timestamptz
  usuarioActualizacion String?   @map("usuario_actualizacion") @db.VarChar(100)

  // Relaciones
  plan                    planes?                            @relation(fields: [planId], references: [id])
  usuarios                usuario_tiendas[]
  invitaciones            invitaciones[]
  cupones                 cupones[]
  usosRecursos            tienda_uso_recursos[]
  preciosHistorial        producto_precio_historial[]
  campanaPromociones      campana_promociones[]
  promocionCategorias     campana_promocion_categorias[]
  promocionProductos      campana_promocion_productos[]
  promocionConfirmaciones campana_promocion_confirmaciones[]
  avisoLive               avisos_live?
  conversacionesAgente    agente_conversaciones[]
  libroReclamaciones      libro_reclamaciones[]
  configReservas          config_reservas?
  hotelTemporadas         hotel_temporadas[]
  hotelExtras             hotel_extras[]
  hotelPlanes             hotel_planes[]
  textos                  tienda_textos[]
}

// ============================================
// MÓDULO: AVISO DE LIVE
// Una fila por tienda. El emprendedor transmite en TikTok/YouTube/Facebook;
// esta plataforma NO transmite video: solo guarda los links y avisa a la tienda
// que hay un live activo. El storefront lee vía Supabase Realtime con el rol
// anon (SELECT público) — ver docs/sql/live_rls_realtime.sql. Todas las
// escrituras pasan por el backend con Prisma.
// ============================================
model avisos_live {
  id       String @id @default(uuid()) @db.Uuid
  tiendaId String @unique @map("tienda_id") @db.Uuid

  activo Boolean @default(false)
  titulo String? @db.VarChar(100)

  // Links persistentes — se conservan entre lives para no re-pegarlos.
  tiktokUrl   String? @map("tiktok_url") @db.Text
  youtubeUrl  String? @map("youtube_url") @db.Text
  facebookUrl String? @map("facebook_url") @db.Text

  // Qué plataformas se muestran en el live ACTUAL.
  mostrarTiktok   Boolean @default(false) @map("mostrar_tiktok")
  mostrarYoutube  Boolean @default(false) @map("mostrar_youtube")
  mostrarFacebook Boolean @default(false) @map("mostrar_facebook")

  iniciadoEn DateTime? @map("iniciado_en") @db.Timestamptz
  expiraEn   DateTime? @map("expira_en") @db.Timestamptz

  // Auditoría
  fechaRegistro        DateTime? @default(now()) @map("fecha_registro") @db.Timestamptz
  usuarioRegistro      String?   @map("usuario_registro") @db.VarChar(100)
  fechaActualizacion   DateTime? @map("fecha_actualizacion") @db.Timestamptz
  usuarioActualizacion String?   @map("usuario_actualizacion") @db.VarChar(100)

  tienda tiendas @relation(fields: [tiendaId], references: [id], onDelete: Cascade)

  @@index([activo, expiraEn], name: "idx_avisos_live_activo_expira")
}

model tienda_configuraciones {
  id        String  @id @default(uuid()) @db.Uuid
  tiendaId  String  @map("tienda_id") @db.Uuid
  clave     String  @db.VarChar(100)
  valor     Json?   @db.JsonB
  categoria String? @db.VarChar(50)

  // Auditoría
  fechaRegistro        DateTime? @default(now()) @map("fecha_registro") @db.Timestamptz
  usuarioRegistro      String?   @map("usuario_registro") @db.VarChar(100)
  fechaActualizacion   DateTime? @map("fecha_actualizacion") @db.Timestamptz
  usuarioActualizacion String?   @map("usuario_actualizacion") @db.VarChar(100)

  @@unique([tiendaId, clave], name: "uq_tienda_clave")
}

// ── Idiomas de la tienda (docs/specs/idiomas) ─────────────────────────────

// Idiomas que ofrece la plataforma; los da de alta su administrador. La PK es
// el código (BCP 47: es, qu, ay, en, agr, es-PE) y no un uuid porque así se
// guarda en todas partes: tiendas.idiomas, pedidos.idioma, las claves de los
// JSONB `traducciones`. El español (IDIOMA_BASE) es una fila más.
model idiomas {
  codigo  String  @id @db.VarChar(10)
  nombre  String  @db.VarChar(60) // en la propia lengua: Runasimi, Aymar aru
  pais    String  @db.VarChar(2) // ISO 3166: solo agrupa la lista en el admin
  locale  String  @db.VarChar(10) // formato de números (Intl): es-PE, en-US
  ia      Boolean @default(false) // el admin ofrece "Traducir con IA"
  avisoIa Boolean @default(false) @map("aviso_ia") // "revisa con un hablante"
  activo  Boolean @default(true)
  orden   Int     @default(0)

  fechaRegistro        DateTime? @default(now()) @map("fecha_registro") @db.Timestamptz
  usuarioRegistro      String?   @map("usuario_registro") @db.VarChar(100)
  fechaActualizacion   DateTime? @map("fecha_actualizacion") @db.Timestamptz
  usuarioActualizacion String?   @map("usuario_actualizacion") @db.VarChar(100)

  textosPlataforma textos_plataforma[]
  textosTienda     tienda_textos[]
}

// Catálogo de textos fijos (botones, títulos, correos, errores). La clave es
// el texto en español tal como está en el código ('Agregar al carrito',
// 'Salida|tour'). Lo carga el seeder desde claves-tienda.json y las claves
// del servidor; una clave que desaparece del código queda obsoleta, no se borra.
model textos_claves {
  clave    String   @id @db.Text
  grupos   String[] @db.Text // comun | productos | hotel | tours | ... | correos | errores (todos los de las carpetas donde se usa)
  obsoleta Boolean  @default(false)

  fechaRegistro        DateTime? @default(now()) @map("fecha_registro") @db.Timestamptz
  usuarioRegistro      String?   @map("usuario_registro") @db.VarChar(100)
  fechaActualizacion   DateTime? @map("fecha_actualizacion") @db.Timestamptz
  usuarioActualizacion String?   @map("usuario_actualizacion") @db.VarChar(100)

  textosPlataforma textos_plataforma[]
  textosTienda     tienda_textos[]
}

// Traducción de un texto fijo que ofrece la plataforma (opcional; p. ej. el
// inglés que antes estaba en textos.en.ts). La tienda puede reemplazarla.
model textos_plataforma {
  idioma String @db.VarChar(10)
  clave  String @db.Text
  texto  String @db.Text

  fechaRegistro        DateTime? @default(now()) @map("fecha_registro") @db.Timestamptz
  usuarioRegistro      String?   @map("usuario_registro") @db.VarChar(100)
  fechaActualizacion   DateTime? @map("fecha_actualizacion") @db.Timestamptz
  usuarioActualizacion String?   @map("usuario_actualizacion") @db.VarChar(100)

  idiomaRel idiomas       @relation(fields: [idioma], references: [codigo])
  claveRel  textos_claves @relation(fields: [clave], references: [clave], onDelete: Cascade)

  @@id([idioma, clave])
  @@index([clave], name: "idx_textos_plataforma_clave")
}

// Traducción de un texto fijo hecha por la tienda (a mano o con "Traducir con
// IA"). Gana sobre la de la plataforma.
model tienda_textos {
  tiendaId String @map("tienda_id") @db.Uuid
  idioma   String @db.VarChar(10)
  clave    String @db.Text
  texto    String @db.Text
  origen   String @default("manual") @db.VarChar(10) // manual | ia

  fechaRegistro        DateTime? @default(now()) @map("fecha_registro") @db.Timestamptz
  usuarioRegistro      String?   @map("usuario_registro") @db.VarChar(100)
  fechaActualizacion   DateTime? @map("fecha_actualizacion") @db.Timestamptz
  usuarioActualizacion String?   @map("usuario_actualizacion") @db.VarChar(100)

  tienda    tiendas       @relation(fields: [tiendaId], references: [id], onDelete: Cascade)
  idiomaRel idiomas       @relation(fields: [idioma], references: [codigo])
  claveRel  textos_claves @relation(fields: [clave], references: [clave], onDelete: Cascade)

  @@id([tiendaId, idioma, clave])
  @@index([idioma], name: "idx_tienda_textos_idioma")
  @@index([clave], name: "idx_tienda_textos_clave")
}

// Plantillas de diseño de la plataforma creadas o editadas desde el editor
// (docs/specs/editor-diseno-en-vivo, fase 2; docs/sql/plantillas_diseno.sql).
// Sin tienda_id: son de la plataforma. Las de modules/diseno/plantillas.js
// son la base; una fila con el mismo id las reemplaza.
model plantillas_diseno {
  id          String  @id @db.VarChar(60)
  tipoNegocio String  @map("tipo_negocio") @db.VarChar(30)
  rubro       String  @default("general") @db.VarChar(30)
  nombre      String  @db.VarChar(80)
  descripcion String  @default("") @db.VarChar(300)
  version     Int     @default(1)
  orden       Int     @default(0)
  activa      Boolean @default(true)
  contenido   Json    @db.JsonB

  // Auditoría
  fechaRegistro        DateTime? @default(now()) @map("fecha_registro") @db.Timestamptz
  usuarioRegistro      String?   @map("usuario_registro") @db.VarChar(100)
  fechaActualizacion   DateTime? @map("fecha_actualizacion") @db.Timestamptz
  usuarioActualizacion String?   @map("usuario_actualizacion") @db.VarChar(100)

  @@index([tipoNegocio, orden], map: "idx_plantillas_diseno_tipo")
}

// ============================================
// MÓDULO: PLANES Y CUOTAS DE USO
// ============================================

model planes {
  id                          String   @id @default(uuid()) @db.Uuid
  codigo                      String   @unique @db.VarChar(50)
  nombre                      String   @db.VarChar(100)
  limiteImagenesIaMes         Int?     @map("limite_imagenes_ia_mes")
  // Consultas IA por mes (1 mensaje = 1 consulta). null = ilimitado. Ver docs/sql/consumo_ia.sql
  limiteConsultasAsesorMes    Int?     @map("limite_consultas_asesor_mes")
  limiteConsultasAsistenteMes Int?     @map("limite_consultas_asistente_mes")
  // Tope diario de la Guía (anti-atracón, además del mensual). null = sin tope diario.
  limiteConsultasAsistenteDia Int?     @map("limite_consultas_asistente_dia")
  precioImagenExcedente       Decimal? @map("precio_imagen_excedente") @db.Decimal(10, 2)
  precioMensual               Decimal? @map("precio_mensual") @db.Decimal(10, 2)
  // Horas de transmisión en vivo (plan Privado) incluidas por mes; no se acumulan.
  // docs/specs/transmision-eventos (R7). 0 = solo con paquete.
  horasTransmisionMes         Int      @default(0) @map("horas_transmision_mes")
  orden                       Int      @default(0)
  activo                      Boolean  @default(true)

  // Auditoría
  fechaRegistro        DateTime? @default(now()) @map("fecha_registro") @db.Timestamptz
  usuarioRegistro      String?   @map("usuario_registro") @db.VarChar(100)
  fechaActualizacion   DateTime? @map("fecha_actualizacion") @db.Timestamptz
  usuarioActualizacion String?   @map("usuario_actualizacion") @db.VarChar(100)

  // Relaciones
  tiendas tiendas[]
}

model tienda_uso_recursos {
  id               String    @id @default(uuid()) @db.Uuid
  tiendaId         String    @map("tienda_id") @db.Uuid
  recurso          String    @db.VarChar(50)
  // "YYYY-MM" (recursos mensuales) o "YYYY-MM-DD" (recursos *_dia)
  periodo          String    @db.VarChar(10)
  cantidadUsada    Int       @default(0) @map("cantidad_usada")
  cantidadIncluida Int?      @map("cantidad_incluida")
  // Solo recursos de consultas IA: costo real para la plataforma y aviso por correo (uno por mes)
  tokensEntrada    BigInt    @default(0) @map("tokens_entrada")
  tokensSalida     BigInt    @default(0) @map("tokens_salida")
  avisoEnviadoEn   DateTime? @map("aviso_enviado_en") @db.Timestamptz

  // Auditoría
  fechaRegistro        DateTime? @default(now()) @map("fecha_registro") @db.Timestamptz
  usuarioRegistro      String?   @map("usuario_registro") @db.VarChar(100)
  fechaActualizacion   DateTime? @map("fecha_actualizacion") @db.Timestamptz
  usuarioActualizacion String?   @map("usuario_actualizacion") @db.VarChar(100)

  // Relaciones
  tienda tiendas @relation(fields: [tiendaId], references: [id])

  @@unique([tiendaId, recurso, periodo], name: "uq_tienda_recurso_periodo")
}

model ia_uso_global {
  id            String @id @default(uuid()) @db.Uuid
  periodo       String @db.VarChar(10) // "YYYY-MM-DD" si tipo=dia, "YYYY-MM" si tipo=mes
  tipo          String @db.VarChar(10) // "dia" | "mes"
  cantidadUsada Int    @default(0) @map("cantidad_usada")

  // Auditoría
  fechaRegistro      DateTime? @default(now()) @map("fecha_registro") @db.Timestamptz
  fechaActualizacion DateTime? @map("fecha_actualizacion") @db.Timestamptz

  @@unique([periodo, tipo], name: "uq_periodo_tipo")
}

// ============================================
// MÓDULO: CUPONES
// ============================================

model cupones {
  id                  String    @id @default(uuid()) @db.Uuid
  tiendaId            String    @map("tienda_id") @db.Uuid
  codigo              String    @db.VarChar(50)
  tipo                String    @db.VarChar(20)
  valor               Decimal   @db.Decimal(10, 2)
  minimoCompra        Decimal   @default(0) @map("minimo_compra") @db.Decimal(10, 2)
  usoMaximo           Int?      @map("uso_maximo")
  usoMaximoPorCliente Int?      @default(1) @map("uso_maximo_por_cliente")
  usoActual           Int       @default(0) @map("uso_actual")
  fechaInicio         DateTime? @default(now()) @map("fecha_inicio") @db.Timestamptz
  fechaFin            DateTime? @map("fecha_fin") @db.Timestamptz
  activo              Boolean   @default(true)
  createdAt           DateTime? @default(now()) @map("created_at") @db.Timestamptz
  // Cupón de una campaña (R4.8): vale solo mientras su promoción aplica (C7).
  campanaPromocionId  String?   @unique @map("campana_promocion_id") @db.Uuid

  tienda           tiendas              @relation(fields: [tiendaId], references: [id], onDelete: Cascade)
  campanaPromocion campana_promociones? @relation(fields: [campanaPromocionId], references: [id], onDelete: Cascade)

  @@unique([tiendaId, codigo], name: "uq_cupon_tienda_codigo")
  @@index([tiendaId], name: "idx_cupones_tienda")
  @@index([tiendaId, activo], name: "idx_cupones_tienda_activo")
}

// ============================================
// MÓDULO: CATEGORÍAS
// ============================================

model categorias {
  id               String  @id @default(uuid()) @db.Uuid
  tiendaId         String  @map("tienda_id") @db.Uuid
  categoriaPadreId String? @map("categoria_padre_id") @db.Uuid
  nombre           String  @db.VarChar(100)
  slug             String  @db.VarChar(100)
  // Código corto que el admin reconoce rápido (en un hotel: MT = Matrimonial, PR = Prince)
  codigo           String? @db.VarChar(10)
  descripcion      String? @db.Text
  traducciones     Json?   @db.JsonB // { en: { nombre, descripcion } } (hospedaje-completo C3)
  imagenUrl        String? @map("imagen_url") @db.VarChar(500)
  orden            Int     @default(0)
  activo           Boolean @default(true)

  // Alcance de las promociones de campaña que la incluyen (campanas-descuento C3a).
  promociones campana_promocion_categorias[]

  // Auditoría
  fechaRegistro        DateTime? @default(now()) @map("fecha_registro") @db.Timestamptz
  usuarioRegistro      String?   @map("usuario_registro") @db.VarChar(100)
  fechaActualizacion   DateTime? @map("fecha_actualizacion") @db.Timestamptz
  usuarioActualizacion String?   @map("usuario_actualizacion") @db.VarChar(100)

  @@index([tiendaId, activo], name: "idx_categorias_tienda_activo")
  @@index([tiendaId, slug], name: "idx_categorias_tienda_slug")
}

// ============================================
// MÓDULO: MARCAS (solo rubros con la capacidad `marcas`, ver modules/negocio)
// ============================================

// Catálogo de marcas de la tienda: el producto elige una de la lista, así
// "Nike" y "nike " no quedan como dos marcas (slug único por tienda).
// Ver docs/sql/productos_marcas.sql.
model marcas {
  id       String  @id @default(uuid()) @db.Uuid
  tiendaId String  @map("tienda_id") @db.Uuid
  nombre   String  @db.VarChar(100)
  slug     String  @db.VarChar(100)
  logoUrl  String? @map("logo_url") @db.VarChar(500)
  orden    Int     @default(0)
  activo   Boolean @default(true)

  // Auditoría
  fechaRegistro        DateTime? @default(now()) @map("fecha_registro") @db.Timestamptz
  usuarioRegistro      String?   @map("usuario_registro") @db.VarChar(100)
  fechaActualizacion   DateTime? @map("fecha_actualizacion") @db.Timestamptz
  usuarioActualizacion String?   @map("usuario_actualizacion") @db.VarChar(100)

  productos productos[]

  @@unique([tiendaId, slug], name: "uq_marcas_tienda_slug")
  @@index([tiendaId, activo], name: "idx_marcas_tienda_activo")
}

// ============================================
// MÓDULO: PRODUCTOS
// ============================================

model productos {
  id               String   @id @default(uuid()) @db.Uuid
  tiendaId         String   @map("tienda_id") @db.Uuid
  categoriaId      String?  @map("categoria_id") @db.Uuid
  // Solo rubros con la capacidad `marcas` (productos); la marca es de la misma tienda (validarMarca).
  marcaId          String?  @map("marca_id") @db.Uuid
  nombre           String   @db.VarChar(200)
  slug             String   @db.VarChar(200)
  descripcion      String?  @db.Text
  descripcionCorta String?  @map("descripcion_corta") @db.VarChar(500)
  traducciones     Json?    @db.JsonB // { en: { nombre, descripcionCorta, descripcion } } (hospedaje-completo C3)
  sku              String?  @db.VarChar(50)
  precioBase       Decimal  @map("precio_base") @db.Decimal(10, 2)
  precioOferta     Decimal? @map("precio_oferta") @db.Decimal(10, 2)
  precioCosto      Decimal? @map("precio_costo") @db.Decimal(10, 2)
  stock            Int      @default(0)
  stockAlerta      Int      @default(5) @map("stock_alerta")
  unidad           String?  @default("pieza") @db.VarChar(20)
  activo           Boolean  @default(true)
  destacado        Boolean  @default(false)
  esServicio       Boolean  @default(false) @map("es_servicio")
  etiquetas        String[]
  // Paleta fija (COLORES_PRODUCTO en productos.schema.js). Ver docs/sql/productos_colores.sql.
  colores          String[] @default([])
  metadata         Json?    @db.JsonB
  // Resumen de reseñas APROBADAS, desnormalizado para tarjetas y orden por
  // valoración. Lo recalcula resenas.service en cada cambio de estado.
  ratingPromedio   Float    @default(0) @map("rating_promedio")
  ratingCantidad   Int      @default(0) @map("rating_cantidad")
  // Puntaje para "Mejor valorados" (promedio bayesiano): un 5.0 con 1 reseña
  // no supera a un 4.9 con 40. 0 = sin reseñas (van al final).
  ratingScore      Float    @default(0) @map("rating_score")

  // Auditoría
  fechaRegistro        DateTime? @default(now()) @map("fecha_registro") @db.Timestamptz
  usuarioRegistro      String?   @map("usuario_registro") @db.VarChar(100)
  fechaActualizacion   DateTime? @map("fecha_actualizacion") @db.Timestamptz
  usuarioActualizacion String?   @map("usuario_actualizacion") @db.VarChar(100)

  // Relaciones
  // Borrar la marca deja sus productos sin marca, no los borra.
  marca            marcas?                       @relation(fields: [marcaId], references: [id], onDelete: SetNull)
  variantes        producto_variantes[]
  preciosHistorial producto_precio_historial[]
  promociones      campana_promocion_productos[]
  imagenes         producto_imagenes[]
  resenas          resenas[]
  // Mini booking: ficha de hotel o de tour (1:1), fechas cerradas y reservas de este producto
  hotelTipo        hotel_tipos_habitacion?
  tour             tours?
  evento           eventos?
  salon            local_salones?
  cancha           cancha_canchas?
  cierres          cierres_fecha[]
  reservas         reservas[]

  @@index([tiendaId, activo], name: "idx_productos_tienda_activo")
  @@index([tiendaId, categoriaId], name: "idx_productos_tienda_categoria")
  @@index([tiendaId, marcaId], name: "idx_productos_tienda_marca")
  @@index([tiendaId, slug], name: "idx_productos_tienda_slug")
  @@index([tiendaId, destacado], name: "idx_productos_tienda_destacado")
  @@index([tiendaId, ratingScore(sort: Desc)], name: "idx_productos_tienda_rating")
}

// ============================================
// MÓDULO: PRODUCTO VARIANTES
// ============================================

model producto_variantes {
  id         String   @id @default(uuid()) @db.Uuid
  productoId String   @map("producto_id") @db.Uuid
  nombre     String   @db.VarChar(100)
  sku        String?  @db.VarChar(50)
  precio     Decimal? @db.Decimal(10, 2)
  stock      Int      @default(0)
  atributos  Json?    @db.JsonB
  activo     Boolean  @default(true)

  // Auditoría
  fechaRegistro        DateTime? @default(now()) @map("fecha_registro") @db.Timestamptz
  usuarioRegistro      String?   @map("usuario_registro") @db.VarChar(100)
  fechaActualizacion   DateTime? @map("fecha_actualizacion") @db.Timestamptz
  usuarioActualizacion String?   @map("usuario_actualizacion") @db.VarChar(100)

  // Relaciones
  producto         productos                   @relation(fields: [productoId], references: [id], onDelete: Cascade)
  preciosHistorial producto_precio_historial[]

  @@index([productoId], name: "idx_variantes_producto")
}

// Historial del precio regular (campanas-descuento C2, R10.4). Lo llenan triggers de BD
// (docs/sql/campanas_descuento_historial.sql): el código solo lo lee. Inmutable.
model producto_precio_historial {
  id             String   @id @default(uuid()) @db.Uuid
  tiendaId       String   @map("tienda_id") @db.Uuid
  productoId     String   @map("producto_id") @db.Uuid
  // null = precio del producto; con valor = precio de esa variante
  varianteId     String?  @map("variante_id") @db.Uuid
  precioAnterior Decimal? @map("precio_anterior") @db.Decimal(10, 2)
  precioNuevo    Decimal? @map("precio_nuevo") @db.Decimal(10, 2)
  motivo         String   @db.VarChar(20) // alta | cambio | linea_base
  usuario        String?  @db.VarChar(100)
  fecha          DateTime @default(now()) @db.Timestamptz

  tienda   tiendas             @relation(fields: [tiendaId], references: [id], onDelete: Cascade)
  producto productos           @relation(fields: [productoId], references: [id], onDelete: Cascade)
  variante producto_variantes? @relation(fields: [varianteId], references: [id], onDelete: Cascade)

  @@index([tiendaId, productoId, fecha(sort: Desc)], name: "idx_precio_historial_producto")
}

// ============================================
// MÓDULO: PROMOCIÓN DE UNA CAMPAÑA (docs/specs/campanas-descuento, C3a)
// ============================================

// Descuento por porcentaje de una campaña. La campaña vive en el JSON de
// tienda_configuraciones (clave "campanas"): se liga por su id UUID, sin FK.
// Ver docs/sql/campanas_descuento_promociones.sql.
model campana_promociones {
  id                   String    @id @default(uuid()) @db.Uuid
  tiendaId             String    @map("tienda_id") @db.Uuid
  campanaId            String    @map("campana_id") @db.Uuid
  porcentaje           Int       @db.SmallInt // 1 a 90
  alcance              String    @db.VarChar(12) // tienda | categorias | productos
  permitirCupones      Boolean   @default(false) @map("permitir_cupones")
  permitirEnvioGratis  Boolean   @default(false) @map("permitir_envio_gratis")
  // Sube con cada cambio de lo que se cobra (R9.5): la confirmación es de una versión.
  version              Int       @default(1)
  fechaRegistro        DateTime? @default(now()) @map("fecha_registro") @db.Timestamptz
  usuarioRegistro      String?   @map("usuario_registro") @db.VarChar(100)
  fechaActualizacion   DateTime? @map("fecha_actualizacion") @db.Timestamptz
  usuarioActualizacion String?   @map("usuario_actualizacion") @db.VarChar(100)

  tienda         tiendas                            @relation(fields: [tiendaId], references: [id], onDelete: Cascade)
  categorias     campana_promocion_categorias[]
  productos      campana_promocion_productos[]
  confirmaciones campana_promocion_confirmaciones[]
  cupon          cupones?

  @@unique([tiendaId, campanaId], name: "uq_promocion_campana")
}

model campana_promocion_categorias {
  promocionId String @map("promocion_id") @db.Uuid
  tiendaId    String @map("tienda_id") @db.Uuid
  categoriaId String @map("categoria_id") @db.Uuid

  promocion campana_promociones @relation(fields: [promocionId], references: [id], onDelete: Cascade)
  tienda    tiendas             @relation(fields: [tiendaId], references: [id], onDelete: Cascade)
  categoria categorias          @relation(fields: [categoriaId], references: [id], onDelete: Cascade)

  @@id([promocionId, categoriaId])
  @@index([tiendaId, categoriaId], name: "idx_promocion_categorias_tienda")
}

model campana_promocion_productos {
  promocionId String @map("promocion_id") @db.Uuid
  tiendaId    String @map("tienda_id") @db.Uuid
  productoId  String @map("producto_id") @db.Uuid

  promocion campana_promociones @relation(fields: [promocionId], references: [id], onDelete: Cascade)
  tienda    tiendas             @relation(fields: [tiendaId], references: [id], onDelete: Cascade)
  producto  productos           @relation(fields: [productoId], references: [id], onDelete: Cascade)

  @@id([promocionId, productoId])
  @@index([tiendaId, productoId], name: "idx_promocion_productos_tienda")
}

// Quién confirmó, cuándo y qué (R9.4), para una versión y una ventana exactas.
// Solo se agrega: un trigger impide editarla (salvo el SET NULL al borrar la promoción).
model campana_promocion_confirmaciones {
  id               String   @id @default(uuid()) @db.Uuid
  tiendaId         String   @map("tienda_id") @db.Uuid
  promocionId      String?  @map("promocion_id") @db.Uuid
  campanaId        String   @map("campana_id") @db.Uuid
  promocionVersion Int      @map("promocion_version")
  ventanaInicio    DateTime @map("ventana_inicio") @db.Timestamptz
  ventanaFin       DateTime @map("ventana_fin") @db.Timestamptz
  detalle          Json     @db.JsonB // porcentaje, alcance e ids, permisos, cupón, avisos mostrados
  confirmadoPor    String   @map("confirmado_por") @db.VarChar(100)
  confirmadoEn     DateTime @default(now()) @map("confirmado_en") @db.Timestamptz

  tienda    tiendas              @relation(fields: [tiendaId], references: [id], onDelete: Cascade)
  promocion campana_promociones? @relation(fields: [promocionId], references: [id], onDelete: SetNull)

  @@unique([promocionId, promocionVersion, ventanaInicio, ventanaFin], name: "uq_confirmacion_version_ventana")
  @@index([tiendaId, campanaId, confirmadoEn(sort: Desc)], name: "idx_confirmaciones_tienda")
}

// ============================================
// MÓDULO: PRODUCTO IMÁGENES
// ============================================

model producto_imagenes {
  id               String  @id @default(uuid()) @db.Uuid
  productoId       String  @map("producto_id") @db.Uuid
  varianteId       String? @map("variante_id") @db.Uuid
  // Valor de la opción principal del producto al que pertenece la foto
  // ("negro", "Stitch"); null = foto general. Ver docs/sql/producto_imagenes_valor_opcion.sql.
  valorOpcion      String? @map("valor_opcion") @db.VarChar(30)
  url              String  @db.VarChar(500)
  urlJpeg          String? @map("url_jpeg") @db.VarChar(500)
  storagePath      String? @map("storage_path") @db.VarChar(500)
  storagePathJpeg  String? @map("storage_path_jpeg") @db.VarChar(500)
  textoAlternativo String? @map("texto_alternativo") @db.VarChar(200)
  orden            Int     @default(0)
  esPrincipal      Boolean @default(false) @map("es_principal")

  // Auditoría
  fechaRegistro        DateTime? @default(now()) @map("fecha_registro") @db.Timestamptz
  usuarioRegistro      String?   @map("usuario_registro") @db.VarChar(100)
  fechaActualizacion   DateTime? @map("fecha_actualizacion") @db.Timestamptz
  usuarioActualizacion String?   @map("usuario_actualizacion") @db.VarChar(100)

  // Relaciones
  producto productos @relation(fields: [productoId], references: [id], onDelete: Cascade)

  @@index([productoId, orden], name: "idx_imagenes_producto_orden")
}

// ============================================
// MÓDULO: PRODUCTO ATRIBUTOS
// ============================================

model producto_atributos {
  id       String   @id @default(uuid()) @db.Uuid
  tiendaId String   @map("tienda_id") @db.Uuid
  nombre   String   @db.VarChar(50)
  valores  String[]
  aplicaA  String?  @map("aplica_a") @db.VarChar(50)

  // Auditoría
  fechaRegistro        DateTime? @default(now()) @map("fecha_registro") @db.Timestamptz
  usuarioRegistro      String?   @map("usuario_registro") @db.VarChar(100)
  fechaActualizacion   DateTime? @map("fecha_actualizacion") @db.Timestamptz
  usuarioActualizacion String?   @map("usuario_actualizacion") @db.VarChar(100)

  @@index([tiendaId], name: "idx_atributos_tienda")
}

// ============================================
// MÓDULO: CLIENTES
// ============================================

model clientes {
  id                      String    @id @default(uuid()) @db.Uuid
  tiendaId                String    @map("tienda_id") @db.Uuid
  whatsappNumero          String    @map("whatsapp_numero") @db.VarChar(20)
  nombre                  String?   @db.VarChar(100)
  email                   String?   @db.VarChar(100)
  tipoDocumento           String?   @map("tipo_documento") @db.VarChar(10)
  numeroDocumento         String?   @map("numero_documento") @db.VarChar(20)
  direccionPredeterminada String?   @map("direccion_predeterminada") @db.Text
  ubigeo                  String?   @db.VarChar(8)
  notas                   String?   @db.Text
  totalPedidos            Int       @default(0) @map("total_pedidos")
  totalGastado            Decimal   @default(0) @map("total_gastado") @db.Decimal(12, 2)
  ultimoPedidoFecha       DateTime? @map("ultimo_pedido_fecha") @db.Timestamptz

  // Auditoría
  fechaRegistro        DateTime? @default(now()) @map("fecha_registro") @db.Timestamptz
  usuarioRegistro      String?   @map("usuario_registro") @db.VarChar(100)
  fechaActualizacion   DateTime? @map("fecha_actualizacion") @db.Timestamptz
  usuarioActualizacion String?   @map("usuario_actualizacion") @db.VarChar(100)

  // Relaciones
  pedidos pedidos[]

  @@unique([tiendaId, whatsappNumero], name: "uq_cliente_whatsapp")
  @@index([tiendaId], name: "idx_clientes_tienda")
  @@index([tiendaId, ultimoPedidoFecha(sort: Desc)], name: "idx_clientes_tienda_fecha")
}

// ============================================
// MÓDULO: PEDIDOS
// ============================================

model pedidos {
  id                   String    @id @default(uuid()) @db.Uuid
  tiendaId             String    @map("tienda_id") @db.Uuid
  clienteId            String?   @map("cliente_id") @db.Uuid
  clienteNombre        String?   @map("cliente_nombre") @db.VarChar(100)
  clienteWhatsapp      String?   @map("cliente_whatsapp") @db.VarChar(20)
  clienteEmail         String?   @map("cliente_email") @db.VarChar(100)
  // Usuario de Supabase Auth (login con Google en el storefront) que hizo el
  // pedido; null si se compró como invitado. Es la base de "Mis pedidos".
  authUserId           String?   @map("auth_user_id") @db.Uuid
  numeroPedido         String    @map("numero_pedido") @db.VarChar(20)
  estado               String    @default("pendiente") @db.VarChar(50)
  subtotal             Decimal   @default(0) @db.Decimal(10, 2)
  descuentoMonto       Decimal   @default(0) @map("descuento_monto") @db.Decimal(10, 2)
  costoEnvio           Decimal   @default(0) @map("costo_envio") @db.Decimal(10, 2)
  total                Decimal   @default(0) @db.Decimal(10, 2)
  metodoPago           String?   @map("metodo_pago") @db.VarChar(50)
  estadoPago           String    @default("pendiente") @map("estado_pago") @db.VarChar(50)
  referenciaPago       String?   @map("referencia_pago") @db.VarChar(100)
  metodoEnvio          String?   @map("metodo_envio") @db.VarChar(50)
  direccionEnvio       String?   @map("direccion_envio") @db.Text
  // Destino de entrega capturado en el checkout (no afecta el total). Según el
  // tipo de envío: courier → courier + agenciaTexto; domicilio → ubigeo +
  // direccionEnvio + referencia (+ pin del mapa).
  courier              String?   @db.VarChar(50)
  agenciaTexto         String?   @map("agencia_texto") @db.Text
  departamento         String?   @db.VarChar(100)
  provincia            String?   @db.VarChar(100)
  distrito             String?   @db.VarChar(100)
  ubigeoCode           String?   @map("ubigeo_code") @db.VarChar(10)
  referencia           String?   @db.Text
  latitud              Float?
  longitud             Float?
  // Comprobante solicitado (boleta/factura/ninguno) + datos del adquiriente,
  // como snapshot del pedido (ver docs/sql/pedido_comprobante_setup.sql)
  comprobante          String?   @db.VarChar(10)
  comprobanteDocTipo   String?   @map("comprobante_doc_tipo") @db.VarChar(10)
  comprobanteDocNumero String?   @map("comprobante_doc_numero") @db.VarChar(20)
  razonSocial          String?   @map("razon_social") @db.VarChar(200)
  direccionFiscal      String?   @map("direccion_fiscal") @db.Text
  notas                String?   @db.Text
  origen               String    @default("web") @db.VarChar(20)
  idioma               String    @default("es") @db.VarChar(10) // idioma en que compró: correos al cliente (docs/specs/idiomas)
  codigoCupon          String?   @map("codigo_cupon") @db.VarChar(50)
  fechaConfirmado      DateTime? @map("fecha_confirmado") @db.Timestamptz
  fechaEntregado       DateTime? @map("fecha_entregado") @db.Timestamptz
  // Mini booking (docs/specs/mini-booking): compra | hotel | tour | evento | local.
  // fecha_servicio = ingreso / salida del tour / inicio de la función.
  tipo                 String    @default("compra") @db.VarChar(10)
  fechaServicio        DateTime? @map("fecha_servicio") @db.Timestamptz
  montoPagado          Decimal   @default(0) @map("monto_pagado") @db.Decimal(10, 2)
  idempotencyKey       String?   @map("idempotency_key") @db.Uuid

  // Auditoría
  fechaRegistro        DateTime? @default(now()) @map("fecha_registro") @db.Timestamptz
  usuarioRegistro      String?   @map("usuario_registro") @db.VarChar(100)
  fechaActualizacion   DateTime? @map("fecha_actualizacion") @db.Timestamptz
  usuarioActualizacion String?   @map("usuario_actualizacion") @db.VarChar(100)

  // Relaciones
  cliente           clientes?                  @relation(fields: [clienteId], references: [id], onDelete: SetNull)
  detalles          pedido_detalles[]
  historialEstados  pedido_historial_estados[]
  pagos             pagos[]
  resenas           resenas[]
  hojasReclamacion  libro_reclamaciones[]
  reserva           reservas?
  // Recepción (docs/specs/recepcion R3.5): estadías del mostrador de esta reserva web.
  estadiasRecepcion hotel_estadias[]
  itemsEvento       evento_compra_items[]
  entradasEvento    evento_entradas[]
  partesPago        reserva_partes[]
  // Alquiler de locales (docs/specs/alquiler-locales)
  cuotas            reserva_cuotas[]
  cambios           reserva_cambios[]
  ocupaciones       local_ocupaciones[]
  cotizaciones      local_cotizaciones[]
  // Alquiler de canchas (docs/specs/alquiler-canchas)
  ocupacionesCancha cancha_ocupaciones[]

  @@unique([tiendaId, numeroPedido], name: "uq_numero_pedido")
  @@unique([tiendaId, idempotencyKey], name: "uq_pedidos_idempotency")
  @@index([tiendaId, tipo, fechaServicio], name: "idx_pedidos_tienda_tipo_servicio")
  @@index([tiendaId], name: "idx_pedidos_tienda")
  @@index([tiendaId, estado], name: "idx_pedidos_tienda_estado")
  @@index([tiendaId, estadoPago], name: "idx_pedidos_tienda_estado_pago")
  @@index([tiendaId, fechaRegistro(sort: Desc)], name: "idx_pedidos_tienda_fecha")
  @@index([clienteId], name: "idx_pedidos_cliente")
  @@index([tiendaId, authUserId, fechaRegistro(sort: Desc)], name: "idx_pedidos_tienda_auth_user")
}

// ============================================
// MÓDULO: RESEÑAS (valoración de productos)
// ============================================
// Solo de compras verificadas: el pedido debe estar entregado e incluir el
// producto. Una reseña por (pedido, producto); editarla la vuelve a moderar.
// La restricción 1..5 de estrellas vive en SQL (docs/sql/resenas_setup.sql).

model resenas {
  id              String    @id @default(uuid()) @db.Uuid
  tiendaId        String    @map("tienda_id") @db.Uuid
  productoId      String    @map("producto_id") @db.Uuid
  pedidoId        String    @map("pedido_id") @db.Uuid
  // Usuario de Supabase si reseñó con sesión; null si llegó por el link de WhatsApp.
  authUserId      String?   @map("auth_user_id") @db.Uuid
  estrellas       Int       @db.SmallInt
  comentario      String?   @db.Text
  // "Ana G." — derivado del nombre del pedido; nunca el nombre completo.
  nombreMostrado  String    @map("nombre_mostrado") @db.VarChar(60)
  // pendiente | aprobada | rechazada
  estado          String    @default("pendiente") @db.VarChar(20)
  respuestaTienda String?   @map("respuesta_tienda") @db.Text
  fechaRespuesta  DateTime? @map("fecha_respuesta") @db.Timestamptz

  // Auditoría
  fechaRegistro        DateTime? @default(now()) @map("fecha_registro") @db.Timestamptz
  usuarioRegistro      String?   @map("usuario_registro") @db.VarChar(100)
  fechaActualizacion   DateTime? @map("fecha_actualizacion") @db.Timestamptz
  usuarioActualizacion String?   @map("usuario_actualizacion") @db.VarChar(100)

  // Relaciones
  producto productos @relation(fields: [productoId], references: [id], onDelete: Cascade)
  pedido   pedidos   @relation(fields: [pedidoId], references: [id], onDelete: Cascade)

  @@unique([pedidoId, productoId], name: "uq_resena_pedido_producto")
  @@index([tiendaId, productoId, estado, fechaRegistro(sort: Desc)], name: "idx_resenas_producto_estado")
  @@index([tiendaId, estado, fechaRegistro(sort: Desc)], name: "idx_resenas_tienda_estado")
}

// ============================================
// MÓDULO: PEDIDO DETALLES
// ============================================

model pedido_detalles {
  id             String   @id @default(uuid()) @db.Uuid
  pedidoId       String   @map("pedido_id") @db.Uuid
  productoId     String?  @map("producto_id") @db.Uuid
  varianteId     String?  @map("variante_id") @db.Uuid
  productoNombre String   @map("producto_nombre") @db.VarChar(200)
  varianteNombre String?  @map("variante_nombre") @db.VarChar(100)
  cantidad       Int      @default(1)
  precioUnitario Decimal  @map("precio_unitario") @db.Decimal(10, 2)
  descuento      Decimal  @default(0) @db.Decimal(10, 2)
  total          Decimal  @db.Decimal(10, 2)
  // Snapshot del precio (precio-en-servidor, ADR-0001 punto 5; docs/sql/precio_en_servidor.sql).
  // NULL = pedido anterior al cambio.
  precioRegular  Decimal? @map("precio_regular") @db.Decimal(10, 2)
  precioOrigen   String?  @map("precio_origen") @db.VarChar(20) // regular | oferta | campana
  // De qué campaña vino el descuento (campanas-descuento R8.3; docs/sql/campanas_descuento_pedidos.sql).
  // Una foto, sin FK: el pedido no cambia si la campaña se edita o se borra.
  campanaId           String? @map("campana_id") @db.Uuid
  campanaNombre       String? @map("campana_nombre") @db.VarChar(120)
  promocionPorcentaje Int?    @map("promocion_porcentaje") @db.SmallInt

  // Relaciones
  pedido pedidos @relation(fields: [pedidoId], references: [id], onDelete: Cascade)

  @@index([pedidoId], name: "idx_detalles_pedido")
}

// ============================================
// MÓDULO: PEDIDO HISTORIAL ESTADOS
// ============================================

model pedido_historial_estados {
  id            String    @id @default(uuid()) @db.Uuid
  pedidoId      String    @map("pedido_id") @db.Uuid
  estado        String    @db.VarChar(50)
  notas         String?   @db.Text
  fechaRegistro DateTime? @default(now()) @map("fecha_registro") @db.Timestamptz

  // Relaciones
  pedido pedidos @relation(fields: [pedidoId], references: [id], onDelete: Cascade)

  @@index([pedidoId], name: "idx_historial_pedido")
}

// ============================================
// MÓDULO: MÉTODOS DE PAGO
// ============================================

model metodos_pago {
  id            String  @id @default(uuid()) @db.Uuid
  tiendaId      String  @map("tienda_id") @db.Uuid
  nombre        String  @db.VarChar(50)
  tipo          String  @db.VarChar(50)
  instrucciones String? @db.Text
  cuentaInfo    Json?   @map("cuenta_info") @db.JsonB
  activo        Boolean @default(true)
  orden         Int     @default(0)

  @@index([tiendaId, activo], name: "idx_metodos_pago_tienda_activo")
}

// ============================================
// MÓDULO: MÉTODOS DE ENVÍO
// ============================================

model metodos_envio {
  id               String   @id @default(uuid()) @db.Uuid
  tiendaId         String   @map("tienda_id") @db.Uuid
  nombre           String   @db.VarChar(50)
  tipo             String   @db.VarChar(30)
  costoReferencial Decimal? @map("costo_referencial") @db.Decimal(10, 2)
  instrucciones    String?  @db.Text
  activo           Boolean  @default(true)
  orden            Int      @default(0)
  // Destino sin zona que lo cubra: "coordinar" (costo por WhatsApp) | "no_disponible" (se oculta)
  fueraDeZona      String   @default("coordinar") @map("fuera_de_zona") @db.VarChar(20)
  // El cliente paga el flete al courier al recoger: no suma al total del pedido
  pagoEnDestino    Boolean  @default(false) @map("pago_en_destino")

  zonas zonas_envio[]

  @@index([tiendaId, activo], name: "idx_metodos_envio_tienda_activo")
}

// Tarifa fija por zona de destino (ver docs/sql/zonas_envio_setup.sql).
// `ubigeos` son prefijos INEI: "15" depto, "1501" provincia, "150122"
// distrito, "*" todo el país. Gana el prefijo más específico.
model zonas_envio {
  id            String    @id @default(uuid()) @db.Uuid
  tiendaId      String    @map("tienda_id") @db.Uuid
  metodoEnvioId String    @map("metodo_envio_id") @db.Uuid
  nombre        String    @db.VarChar(60)
  costo         Decimal   @default(0) @db.Decimal(10, 2)
  diasMin       Int?      @map("dias_min")
  diasMax       Int?      @map("dias_max")
  ubigeos       String[]  @default([]) @db.VarChar(6)
  orden         Int       @default(0)
  fechaRegistro DateTime? @default(now()) @map("fecha_registro") @db.Timestamptz

  metodoEnvio metodos_envio @relation(fields: [metodoEnvioId], references: [id], onDelete: Cascade)

  @@index([metodoEnvioId], name: "idx_zonas_envio_metodo")
  @@index([tiendaId], name: "idx_zonas_envio_tienda")
}

// ============================================
// MÓDULO: PASARELA DE PAGOS (PSP)
// Integración con proveedores de pago online (Culqi, etc.).
// Ver pasarela-de-pagos/ para el análisis y detalle técnico.
// ============================================

// Credenciales de la pasarela por tienda. Cada tienda conecta su propia cuenta
// del proveedor y recibe el dinero en su cuenta (modelo "credenciales propias").
// La llave secreta se guarda CIFRADA (AES-256-GCM) — nunca en texto plano.
model tienda_pasarela_config {
  id                   String  @id @default(uuid()) @db.Uuid
  tiendaId             String  @map("tienda_id") @db.Uuid
  proveedor            String  @db.VarChar(30) // culqi | izipay | ...
  modo                 String  @default("test") @db.VarChar(10) // test | live
  llavePublica         String? @map("llave_publica") @db.VarChar(200) // pk_ — pública, va al frontend
  llaveSecretaCifrada  String? @map("llave_secreta_cifrada") @db.Text // sk_ cifrada (AES-256-GCM)
  webhookSecretCifrado String? @map("webhook_secret_cifrado") @db.Text // secret de verificación de firma, cifrado
  activo               Boolean @default(false)

  // Auditoría
  fechaRegistro        DateTime? @default(now()) @map("fecha_registro") @db.Timestamptz
  usuarioRegistro      String?   @map("usuario_registro") @db.VarChar(100)
  fechaActualizacion   DateTime? @map("fecha_actualizacion") @db.Timestamptz
  usuarioActualizacion String?   @map("usuario_actualizacion") @db.VarChar(100)

  @@unique([tiendaId, proveedor], name: "uq_pasarela_tienda_proveedor")
  @@index([tiendaId, activo], name: "idx_pasarela_tienda_activo")
}

// Un intento/transacción de pago contra la pasarela, ligado a un pedido.
model pagos {
  id               String  @id @default(uuid()) @db.Uuid
  tiendaId         String  @map("tienda_id") @db.Uuid
  pedidoId         String  @map("pedido_id") @db.Uuid
  proveedor        String  @db.VarChar(30) // culqi | ...
  proveedorCargoId String? @map("proveedor_cargo_id") @db.VarChar(100) // chr_... (id del cargo en Culqi)
  metodo           String  @db.VarChar(30) // tarjeta | yape | pago_efectivo | qr_interoperable
  monto            Decimal @db.Decimal(10, 2) // monto en la moneda (S/), NO en céntimos
  moneda           String  @default("PEN") @db.VarChar(3)
  estado           String  @default("pendiente") @db.VarChar(20) // pendiente | pagado | fallido | reembolsado
  outcomeCode      String? @map("outcome_code") @db.VarChar(50) // código del proveedor (ej. AUT0000)
  outcomeMensaje   String? @map("outcome_mensaje") @db.Text
  metadata         Json?   @db.JsonB
  // Alquiler de locales: cuota del plan de pagos que paga (un solo pago válido por cuota, CE-11).
  cuotaId          String? @map("cuota_id") @db.Uuid
  // Canchas: parte del pago dividido que paga un jugador (plantillas-por-rubro E7).
  parteId          String? @map("parte_id") @db.Uuid

  // Auditoría
  fechaRegistro        DateTime? @default(now()) @map("fecha_registro") @db.Timestamptz
  usuarioRegistro      String?   @map("usuario_registro") @db.VarChar(100)
  fechaActualizacion   DateTime? @map("fecha_actualizacion") @db.Timestamptz
  usuarioActualizacion String?   @map("usuario_actualizacion") @db.VarChar(100)

  // Relaciones
  pedido  pedidos         @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  cuota   reserva_cuotas? @relation(fields: [cuotaId], references: [id], onDelete: SetNull)
  parte   reserva_partes? @relation(fields: [parteId], references: [id], onDelete: SetNull)
  eventos pago_eventos[]

  @@unique([proveedor, proveedorCargoId], name: "uq_pago_proveedor_cargo")
  @@index([tiendaId], name: "idx_pagos_tienda")
  @@index([pedidoId], name: "idx_pagos_pedido")
  @@index([tiendaId, estado], name: "idx_pagos_tienda_estado")
  @@index([cuotaId], name: "idx_pagos_cuota")
}

// Bitácora de webhooks recibidos del proveedor. El proveedorEventoId único
// garantiza idempotencia: un mismo evento reenviado no se procesa dos veces.
model pago_eventos {
  id                String    @id @default(uuid()) @db.Uuid
  pagoId            String?   @map("pago_id") @db.Uuid
  proveedor         String    @db.VarChar(30)
  proveedorEventoId String    @map("proveedor_evento_id") @db.VarChar(120)
  tipo              String    @db.VarChar(60) // charge.creation.succeeded | ...
  payload           Json?     @db.JsonB
  procesado         Boolean   @default(false)
  fechaRegistro     DateTime? @default(now()) @map("fecha_registro") @db.Timestamptz

  // Relaciones
  pago pagos? @relation(fields: [pagoId], references: [id], onDelete: SetNull)

  @@unique([proveedor, proveedorEventoId], name: "uq_evento_proveedor")
  @@index([pagoId], name: "idx_pago_eventos_pago")
}

// ============================================
// MÓDULO: AGENTE DE VENTAS IA (asesor del storefront)
// Historial de conversaciones del asesor. Lo guarda y lo lee SOLO el backend:
// el historial que recibe el LLM nunca viene del cliente (ver
// docs/specs/agente-ventas/spec.md, R1). Una conversación es (tienda,
// sessionToken) mientras tenga actividad; tras AGENTE_IA_INACTIVIDAD_MIN se
// abre otra. DDL: docs/sql/agente_conversaciones.sql
// ============================================
model agente_conversaciones {
  id              String   @id @default(uuid()) @db.Uuid
  tiendaId        String   @map("tienda_id") @db.Uuid
  // Token del navegador (localStorage del storefront), no identifica a la persona.
  sessionToken    String   @map("session_token") @db.VarChar(64)
  estado          String   @default("activa") @db.VarChar(20)
  // Turnos completos (mensaje + respuesta). Tope: AGENTE_IA_MAX_TURNOS.
  turnos          Int      @default(0)
  // Fallos consecutivos; con AGENTE_IA_MAX_FALLOS se ofrece pasar con una persona.
  // DDL: docs/sql/agente_conversaciones_fallos.sql
  fallos          Int      @default(0)
  ultimaActividad DateTime @default(now()) @map("ultima_actividad") @db.Timestamptz

  // Auditoría
  fechaRegistro        DateTime? @default(now()) @map("fecha_registro") @db.Timestamptz
  usuarioRegistro      String?   @map("usuario_registro") @db.VarChar(100)
  fechaActualizacion   DateTime? @map("fecha_actualizacion") @db.Timestamptz
  usuarioActualizacion String?   @map("usuario_actualizacion") @db.VarChar(100)

  // Relaciones
  tienda   tiendas           @relation(fields: [tiendaId], references: [id], onDelete: Cascade)
  mensajes agente_mensajes[]

  @@index([tiendaId, sessionToken, ultimaActividad(sort: Desc)], name: "idx_agente_conv_sesion")
}

model agente_mensajes {
  id             String    @id @default(uuid()) @db.Uuid
  // Redundante con la conversación a propósito: entra al auto-scope de Prisma.
  tiendaId       String    @map("tienda_id") @db.Uuid
  conversacionId String    @map("conversacion_id") @db.Uuid
  rol            String    @db.VarChar(20) // user | assistant
  contenido      String    @db.Text
  fechaRegistro  DateTime? @default(now()) @map("fecha_registro") @db.Timestamptz

  // Relaciones
  conversacion agente_conversaciones @relation(fields: [conversacionId], references: [id], onDelete: Cascade)

  @@index([conversacionId, fechaRegistro], name: "idx_agente_mensajes_conv")
}

// ============================================
// MÓDULO: LIBRO DE RECLAMACIONES (Ley 29571, DS 011-2011-PCM, DS 101-2022-PCM)
// Spec: docs/specs/libro-reclamaciones. DDL: docs/sql/libro_reclamaciones_setup.sql
// ============================================
// Una fila = una Hoja de Reclamación (Anexo I). Lo que registró el consumidor
// y el snapshot del proveedor NO se modifican ni se borran: lo impone un
// trigger SQL. Solo cambian estado y respuesta. Conservación mínima: 2 años,
// por eso la FK a tiendas es RESTRICT (la baja de una tienda es lógica).

model libro_reclamaciones {
  id          String   @id @default(uuid()) @db.Uuid
  tiendaId    String   @map("tienda_id") @db.Uuid
  anio        Int      @db.SmallInt
  correlativo Int
  numero      String   @db.VarChar(15) // "00001-2026"
  tipo        String   @db.VarChar(10) // reclamo | queja
  // pendiente | en_atencion | respondida
  estado      String   @default("pendiente") @db.VarChar(20)
  // Día hábil 15 desde el registro (modules/libro-reclamaciones/plazos.js).
  fechaLimite DateTime @map("fecha_limite") @db.Date

  // Snapshot del proveedor al registrarse
  proveedorNombre      String  @map("proveedor_nombre") @db.VarChar(100)
  proveedorRazonSocial String? @map("proveedor_razon_social") @db.VarChar(200)
  proveedorRuc         String? @map("proveedor_ruc") @db.VarChar(20)
  proveedorDireccion   String? @map("proveedor_direccion") @db.Text

  // Consumidor
  consumidorNombres   String  @map("consumidor_nombres") @db.VarChar(150)
  consumidorApellidos String  @map("consumidor_apellidos") @db.VarChar(150)
  consumidorDocTipo   String  @map("consumidor_doc_tipo") @db.VarChar(10) // DNI | CE | PASAPORTE
  consumidorDocNumero String  @map("consumidor_doc_numero") @db.VarChar(20)
  consumidorDomicilio String  @map("consumidor_domicilio") @db.Text
  consumidorTelefono  String? @map("consumidor_telefono") @db.VarChar(20)
  consumidorEmail     String  @map("consumidor_email") @db.VarChar(100)
  esMenor             Boolean @default(false) @map("es_menor")
  apoderadoNombre     String? @map("apoderado_nombre") @db.VarChar(200)
  apoderadoDocTipo    String? @map("apoderado_doc_tipo") @db.VarChar(10)
  apoderadoDocNumero  String? @map("apoderado_doc_numero") @db.VarChar(20)

  // Bien contratado
  bienTipo          String   @map("bien_tipo") @db.VarChar(10) // producto | servicio
  bienDescripcion   String   @map("bien_descripcion") @db.Text
  montoReclamado    Decimal? @map("monto_reclamado") @db.Decimal(10, 2)
  moneda            String   @default("PEN") @db.VarChar(3)
  // Solo si coincide con un pedido real de la tienda; lo escrito queda en numeroPedidoTexto.
  pedidoId          String?  @map("pedido_id") @db.Uuid
  numeroPedidoTexto String?  @map("numero_pedido_texto") @db.VarChar(30)

  // Detalle
  detalle           String  @db.Text
  pedidoConsumidor  String  @map("pedido_consumidor") @db.Text
  medioRespuesta    String  @default("email") @map("medio_respuesta") @db.VarChar(10) // email | domicilio
  aceptaDeclaracion Boolean @map("acepta_declaracion")
  authUserId        String? @map("auth_user_id") @db.Uuid
  // sha256(ip + LIBRO_IP_SALT): rastrea abuso sin guardar la IP.
  ipHash            String? @map("ip_hash") @db.VarChar(64)

  // Respuesta del proveedor
  respuesta      String?   @db.Text
  accionAdoptada String?   @map("accion_adoptada") @db.Text
  // Envío del correo o entrega de la carta.
  fechaRespuesta DateTime? @map("fecha_respuesta") @db.Timestamptz
  respondidoPor  String?   @map("respondido_por") @db.VarChar(100)

  // Auditoría
  fechaRegistro        DateTime  @default(now()) @map("fecha_registro") @db.Timestamptz
  usuarioRegistro      String?   @map("usuario_registro") @db.VarChar(100)
  fechaActualizacion   DateTime? @map("fecha_actualizacion") @db.Timestamptz
  usuarioActualizacion String?   @map("usuario_actualizacion") @db.VarChar(100)

  // Relaciones
  tienda  tiendas                       @relation(fields: [tiendaId], references: [id], onDelete: Restrict)
  pedido  pedidos?                      @relation(fields: [pedidoId], references: [id], onDelete: SetNull)
  eventos libro_reclamaciones_eventos[]

  @@unique([tiendaId, anio, correlativo], name: "uq_libro_correlativo")
  @@index([tiendaId, estado, fechaLimite], name: "idx_libro_tienda_estado_limite")
  @@index([tiendaId, fechaRegistro(sort: Desc)], name: "idx_libro_tienda_fecha")
}

// Historial append-only de la hoja: registro, correos (ok/fallo), cambios de
// estado y respuesta. Prueba que se entregó la constancia y se respondió a tiempo.
model libro_reclamaciones_eventos {
  id            String   @id @default(uuid()) @db.Uuid
  hojaId        String   @map("hoja_id") @db.Uuid
  // registrada | constancia_enviada | constancia_fallo | aviso_tienda_enviado
  // | aviso_tienda_fallo | en_atencion | respondida | respuesta_fallo
  tipo          String   @db.VarChar(30)
  detalle       Json?    @db.JsonB
  usuario       String?  @db.VarChar(100)
  fechaRegistro DateTime @default(now()) @map("fecha_registro") @db.Timestamptz

  // Relaciones
  hoja libro_reclamaciones @relation(fields: [hojaId], references: [id], onDelete: Restrict)

  @@index([hojaId, fechaRegistro], name: "idx_libro_eventos_hoja")
}

// ============================================
// MÓDULO: MINI BOOKING (docs/specs/mini-booking)
// Vitrina + solicitud de reserva que el negocio confirma (hotel / hostal).
// La reserva es un `pedidos` con tipo = hotel + una fila en `reservas`.
// No hay inventario: el negocio acepta o rechaza; solo existen fechas cerradas.
// SQL: docs/sql/mini_booking_setup.sql
// ============================================

// Configuración de reservas de la tienda (una fila por tienda).
model config_reservas {
  tiendaId               String   @id @map("tienda_id") @db.Uuid
  modoConfirmacion       String   @default("solicitud") @map("modo_confirmacion") @db.VarChar(12) // solicitud | pago_directo
  cobro                  String   @default("total") @db.VarChar(10) // total | adelanto | en_destino
  adelantoPct            Int?     @map("adelanto_pct")
  // Límite duro: no se puede enviar si falta menos que esto para el inicio.
  anticipacionMinHoras   Int      @default(0) @map("anticipacion_min_horas")
  // Límite blando: advertencia de reserva próxima (null = sin aviso).
  avisoProximoHoras      Int?     @map("aviso_proximo_horas")
  avisoProximoTexto      String?  @map("aviso_proximo_texto") @db.VarChar(300)
  maxSolicitudesAbiertas Int      @default(3) @map("max_solicitudes_abiertas")
  instrucciones          String?  @db.Text
  politicaCancelacion    String?  @map("politica_cancelacion") @db.Text
  terminos               String?  @db.Text // reserva-hotel-mejoras H4.1: si hay, la solicitud pide aceptarlos
  horaCheckin            String   @default("14:00") @map("hora_checkin") @db.VarChar(5)
  horaCheckout           String   @default("12:00") @map("hora_checkout") @db.VarChar(5)
  comprobanteEn          String   @default("al_pagar") @map("comprobante_en") @db.VarChar(14) // al_pagar | en_el_servicio
  // Solo eventos (fase 3)
  apartadoManualMin      Int      @default(120) @map("apartado_manual_min") // minutos que el cupo queda apartado mientras se paga
  apartadoEnLineaMin     Int      @default(15) @map("apartado_en_linea_min") // ídem, si se paga en línea (reserva-directa-hotel RD6)
  cobroEleccion          Boolean  @default(false) @map("cobro_eleccion") // con adelanto: el cliente elige adelanto o total (plantillas-por-rubro C8)
  // Política de cancelación del hotel (docs/specs/ciclo-reserva-hotel C5)
  cancelacionGratisHoras Int      @default(48) @map("cancelacion_gratis_horas") // gratis si se cancela con al menos estas horas
  penalidadNoches        Int      @default(1) @map("penalidad_noches") // si no, se retienen estas noches
  camposFormulario       Json?    @map("campos_formulario") @db.JsonB // modo de cada campo del formulario (reservas/formulario.js)
  maxEntradasPorCompra   Int      @default(10) @map("max_entradas_por_compra")
  umbralUltimasEntradas  Int?     @default(20) @map("umbral_ultimas_entradas") // "Últimas entradas" si quedan menos; null = nunca
  cierrePagoManualHoras  Int?     @map("cierre_pago_manual_horas") // sin Yape/transferencia N h antes de la función
  // Hospedaje (docs/specs/hospedaje-completo, fase B)
  tipoAlojamiento        String   @default("hotel") @map("tipo_alojamiento") @db.VarChar(12) // hotel | hostal | casa | apart | lodge | posada
  ninosGratisHasta       Int?     @map("ninos_gratis_hasta") // edad hasta la que un niño no paga; null = no aplica cargo
  cargoNinoNoche         Decimal? @map("cargo_nino_noche") @db.Decimal(10, 2) // por niño mayor a esa edad, por noche
  exoneraIgvExtranjeros  Boolean  @default(false) @map("exonera_igv_extranjeros") // turista extranjero: total sin IGV
  preciosConImpuestos    Boolean  @default(true) @map("precios_con_impuestos") // reserva-hotel-mejoras H2: false = se suman IGV y servicio
  recargoServicioPct     Int      @default(0) @map("recargo_servicio_pct") // H2.2: 0 … 13
  // Fase C
  tipoCambioUsd          Decimal? @map("tipo_cambio_usd") @db.Decimal(6, 3) // "≈ US$" en la vitrina; null = no se muestra
  resenasExternas        Json?    @map("resenas_externas") @db.JsonB // [{ fuente, puntaje, cantidad, url }] (hasta 3)
  // Recepción (docs/specs/recepcion R3.2): cuándo pide el documento del huésped en el mostrador.
  recepcionDocumento     String   @default("noche") @map("recepcion_documento") @db.VarChar(8) // siempre | noche | nunca
  // Recepción R8 (fase 4): la tienda online muestra "Disponibilidad ahora" con WhatsApp en lugar del formulario de reserva.
  vitrinaAlPaso          Boolean  @default(false) @map("vitrina_al_paso")
  traducciones           Json?    @db.JsonB // { en: { instrucciones, politicaCancelacion } } (C3)
  // Alquiler de locales (docs/specs/alquiler-locales R1.2). `adelantoPct` es el % cuando separacionTipo = porcentaje.
  separacionTipo         String   @default("porcentaje") @map("separacion_tipo") @db.VarChar(10) // porcentaje | monto_fijo
  separacionMonto        Decimal? @map("separacion_monto") @db.Decimal(10, 2)
  respuestaHoras         Int      @default(24) @map("respuesta_horas") // plazo del negocio para responder (aparta la fecha)
  apartadoHoras          Int      @default(48) @map("apartado_horas") // aceptada sin pagar
  saldoDiasAntes         Int      @default(30) @map("saldo_dias_antes")
  maxCuotas              Int      @default(3) @map("max_cuotas")
  garantiaMonto          Decimal  @default(0) @map("garantia_monto") @db.Decimal(10, 2)
  garantiaDevolucionDias Int      @default(3) @map("garantia_devolucion_dias")
  invitadosConfirmarDias Int      @default(7) @map("invitados_confirmar_dias")
  reprogramacionesMax    Int      @default(1) @map("reprogramaciones_max")
  reprogramacionMinDias  Int      @default(30) @map("reprogramacion_min_dias")
  cargoReprogramacion    Decimal  @default(0) @map("cargo_reprogramacion") @db.Decimal(10, 2)
  politicaTramos         Json?    @map("politica_tramos") @db.JsonB // [{ desdeDias, separacionPct, restoPct }] (desc)
  graciaMoraDias         Int      @default(3) @map("gracia_mora_dias")
  saldoFavorMeses        Int      @default(6) @map("saldo_favor_meses")
  cotizacionVigenciaDias Int      @default(7) @map("cotizacion_vigencia_dias")
  contratoPlantilla      String?  @map("contrato_plantilla") @db.Text
  contratoVersion        Int      @default(1) @map("contrato_version") // sube al guardar la plantilla
  proveedoresExternos    Boolean  @default(true) @map("proveedores_externos")
  tarifaCoordinacion     Decimal? @map("tarifa_coordinacion") @db.Decimal(10, 2)
  descorcheBotella       Decimal? @map("descorche_botella") @db.Decimal(10, 2)
  horaTope               String   @default("03:00") @map("hora_tope") @db.VarChar(5) // ordenanza municipal
  visitasHorario         Json?    @map("visitas_horario") @db.JsonB // { "1": ["16:00-19:00"] } (día ISO → rangos)
  // Alquiler de canchas (docs/specs/alquiler-canchas R2): horario del complejo, en horas en punto.
  canchaApertura         String   @default("07:00") @map("cancha_apertura") @db.VarChar(5)
  canchaCierre           String   @default("23:00") @map("cancha_cierre") @db.VarChar(5) // "00:00" = medianoche
  canchaInicioNoche      String   @default("18:00") @map("cancha_inicio_noche") @db.VarChar(5)
  canchaFindeNoche       Boolean  @default(true) @map("cancha_finde_noche") // sábado, domingo y feriado: tarifa noche todo el día
  canchaDuraciones       Int[]    @default([60, 90, 120]) @map("cancha_duraciones") // minutos

  // Auditoría
  fechaRegistro        DateTime? @default(now()) @map("fecha_registro") @db.Timestamptz
  usuarioRegistro      String?   @map("usuario_registro") @db.VarChar(100)
  fechaActualizacion   DateTime? @map("fecha_actualizacion") @db.Timestamptz
  usuarioActualizacion String?   @map("usuario_actualizacion") @db.VarChar(100)

  tienda tiendas @relation(fields: [tiendaId], references: [id], onDelete: Cascade)
}

// Fechas en que el negocio no recibe reservas. productoId null = todo el negocio.
model cierres_fecha {
  id              String    @id @default(uuid()) @db.Uuid
  tiendaId        String    @map("tienda_id") @db.Uuid
  productoId      String?   @map("producto_id") @db.Uuid
  fechaDesde      DateTime  @map("fecha_desde") @db.Date
  fechaHasta      DateTime  @map("fecha_hasta") @db.Date // inclusiva
  motivo          String?   @db.VarChar(100) // visible solo en el admin
  fechaRegistro   DateTime? @default(now()) @map("fecha_registro") @db.Timestamptz
  usuarioRegistro String?   @map("usuario_registro") @db.VarChar(100)

  producto productos? @relation(fields: [productoId], references: [id], onDelete: Cascade)

  @@index([tiendaId, fechaDesde, fechaHasta], name: "idx_cierres_tienda_rango")
}

// Temporadas del hotel (hospedaje-completo B2): ajuste % sobre el precio de
// cada noche que cae en el rango y mínimo de noches si la llegada cae en él.
model hotel_temporadas {
  id           String   @id @default(uuid()) @db.Uuid
  tiendaId     String   @map("tienda_id") @db.Uuid
  nombre       String   @db.VarChar(60)
  desde        DateTime @db.Date
  hasta        DateTime @db.Date // inclusiva
  ajustePct    Int      @map("ajuste_pct") // -50 … 300
  minNoches    Int?     @map("min_noches")
  productoIds  String[] @default([]) @map("producto_ids") @db.Uuid // vacío = todas las habitaciones
  activo       Boolean  @default(true)
  traducciones Json?    @db.JsonB // { en: { nombre } } (C3)

  fechaRegistro        DateTime? @default(now()) @map("fecha_registro") @db.Timestamptz
  usuarioRegistro      String?   @map("usuario_registro") @db.VarChar(100)
  fechaActualizacion   DateTime? @map("fecha_actualizacion") @db.Timestamptz
  usuarioActualizacion String?   @map("usuario_actualizacion") @db.VarChar(100)

  tienda tiendas @relation(fields: [tiendaId], references: [id], onDelete: Cascade)

  @@index([tiendaId, desde, hasta], name: "idx_hotel_temporadas_rango")
}

// Extras reservables del hotel (hospedaje-completo B3): traslado, early check-in, cuna…
model hotel_extras {
  id           String  @id @default(uuid()) @db.Uuid
  tiendaId     String  @map("tienda_id") @db.Uuid
  nombre       String  @db.VarChar(60)
  descripcion  String? @db.VarChar(200)
  precio       Decimal @db.Decimal(10, 2)
  cobro        String  @default("estadia") @db.VarChar(14) // estadia | noche | persona | persona_noche
  datoPedido   String? @map("dato_pedido") @db.VarChar(80) // lo que se le pide al huésped ("Número de vuelo y hora")
  horario      String? @db.VarChar(5) // early | late: se pide con hora y el hotel lo aprueba (ciclo-reserva-hotel C7)
  activo       Boolean @default(true)
  orden        Int     @default(0)
  traducciones Json?   @db.JsonB // { en: { nombre, descripcion, datoPedido } } (C3)

  fechaRegistro        DateTime? @default(now()) @map("fecha_registro") @db.Timestamptz
  usuarioRegistro      String?   @map("usuario_registro") @db.VarChar(100)
  fechaActualizacion   DateTime? @map("fecha_actualizacion") @db.Timestamptz
  usuarioActualizacion String?   @map("usuario_actualizacion") @db.VarChar(100)

  tienda tiendas @relation(fields: [tiendaId], references: [id], onDelete: Cascade)

  @@index([tiendaId], name: "idx_hotel_extras_tienda")
}

// Planes de tarifa (hospedaje-completo C5): "No reembolsable −10 %". La
// tarifa flexible (sin ajuste, con la política de cancelación de la tienda)
// es implícita.
model hotel_planes {
  id           String  @id @default(uuid()) @db.Uuid
  tiendaId     String  @map("tienda_id") @db.Uuid
  nombre       String  @db.VarChar(60)
  descripcion  String? @db.VarChar(200)
  ajustePct    Int     @map("ajuste_pct") // -50 … 0
  reembolsable Boolean @default(false)
  activo       Boolean @default(true)
  orden        Int     @default(0)
  traducciones Json?   @db.JsonB // { en: { nombre, descripcion } } (C3)

  fechaRegistro        DateTime? @default(now()) @map("fecha_registro") @db.Timestamptz
  usuarioRegistro      String?   @map("usuario_registro") @db.VarChar(100)
  fechaActualizacion   DateTime? @map("fecha_actualizacion") @db.Timestamptz
  usuarioActualizacion String?   @map("usuario_actualizacion") @db.VarChar(100)

  tienda tiendas @relation(fields: [tiendaId], references: [id], onDelete: Cascade)

  @@index([tiendaId], name: "idx_hotel_planes_tienda")
}

// Ficha de hotel de un producto (tipo de habitación).
model hotel_tipos_habitacion {
  productoId       String   @id @map("producto_id") @db.Uuid
  tiendaId         String   @map("tienda_id") @db.Uuid
  capacidadAdultos Int      @default(2) @map("capacidad_adultos")
  capacidadNinos   Int      @default(0) @map("capacidad_ninos")
  capacidadMax     Int      @default(2) @map("capacidad_max")
  // Inventario (hospedaje-completo C1): habitaciones de este tipo (o camas, si
  // el tipo es una cama de dormitorio). null = sin control: el negocio confirma a mano.
  unidades         Int?
  traducciones     Json?    @db.JsonB // { en: { camas, amenities } } (C3)
  camas            String?  @db.VarChar(100)
  metros           Int? // reserva-hotel-mejoras H5.1: tamaño en m²
  amenities        String[] @default([])

  producto            productos            @relation(fields: [productoId], references: [id], onDelete: Cascade)
  modalidades         hotel_modalidades[]
  // Recepción (docs/specs/recepcion R1): con habitaciones físicas, `unidades` = las activas.
  habitacionesFisicas hotel_habitaciones[]
  // Motor de reservas (docs/specs/motor-reservas-hotel M2): lo vendido fuera de la web.
  cupoExterno         hotel_cupo_externo[]

  @@index([tiendaId], name: "idx_hotel_tipos_tienda")
}

// Motor de reservas (docs/specs/motor-reservas-hotel M2): habitaciones de un
// tipo ocupadas una noche por ventas fuera de la web (Booking, WhatsApp, la
// puerta). El dueño fija "libres" y se guarda la diferencia; iCal (M3) escribe
// con su propio origen. `ocupacion()` las suma a las reservas web.
model hotel_cupo_externo {
  id                   String    @id @default(uuid()) @db.Uuid
  tiendaId             String    @map("tienda_id") @db.Uuid
  productoId           String    @map("producto_id") @db.Uuid // tipo de habitación
  fecha                DateTime  @db.Date // la noche
  origen               String    @default("manual") @db.VarChar(10) // manual | ical
  ocupadas             Int
  fechaActualizacion   DateTime? @default(now()) @map("fecha_actualizacion") @db.Timestamptz
  usuarioActualizacion String?   @map("usuario_actualizacion") @db.VarChar(100)

  tipo hotel_tipos_habitacion @relation(fields: [productoId], references: [productoId], onDelete: Cascade)

  @@unique([productoId, fecha, origen], map: "uq_hotel_cupo_externo_noche")
  @@index([tiendaId, fecha], map: "idx_hotel_cupo_externo_tienda_fecha")
}

// Recepción (docs/specs/recepcion R1): habitación física (la 101, "Jacuzzi 2").
// Una tienda usa Recepción cuando tiene habitaciones.
model hotel_habitaciones {
  id         String  @id @default(uuid()) @db.Uuid
  tiendaId   String  @map("tienda_id") @db.Uuid
  productoId String  @map("producto_id") @db.Uuid // tipo de habitación
  numero     String  @db.VarChar(20)
  piso       String? @db.VarChar(20)
  orden      Int     @default(0)
  estado     String  @default("activa") @db.VarChar(14) // activa | mantenimiento
  limpieza   String  @default("limpia") @db.VarChar(12) // limpia | por_limpiar

  fechaRegistro        DateTime? @default(now()) @map("fecha_registro") @db.Timestamptz
  usuarioRegistro      String?   @map("usuario_registro") @db.VarChar(100)
  fechaActualizacion   DateTime? @map("fecha_actualizacion") @db.Timestamptz
  usuarioActualizacion String?   @map("usuario_actualizacion") @db.VarChar(100)

  tipo        hotel_tipos_habitacion @relation(fields: [productoId], references: [productoId], onDelete: Cascade)
  estadias    hotel_estadias[]
  incidencias hotel_incidencias[]

  @@unique([tiendaId, numero], name: "uq_hotel_habitaciones_numero")
  @@index([productoId], name: "idx_hotel_habitaciones_tipo")
}

// Recepción (R3/R4): estadía registrada en el mostrador. "Pasajero libre" =
// sin datos del huésped. Una habitación tiene a lo más una `en_curso` (índice
// parcial en docs/sql/recepcion_fase_1.sql).
model hotel_estadias {
  id               String    @id @default(uuid()) @db.Uuid
  tiendaId         String    @map("tienda_id") @db.Uuid
  habitacionId     String    @map("habitacion_id") @db.Uuid
  productoId       String    @map("producto_id") @db.Uuid // tipo al entrar (snapshot)
  modalidad        String    @db.VarChar(6) // noche | horas (la última: "pasa a noche" la cambia)
  inicio           DateTime  @db.Timestamptz
  fin              DateTime  @db.Timestamptz // salida prevista; extender la mueve
  salida           DateTime? @db.Timestamptz // salida real
  estado           String    @default("en_curso") @db.VarChar(10) // en_curso | cerrada | anulada
  cargos           Json      @db.JsonB // [{ concepto, precioLista, monto, en, usuario }]
  total            Decimal   @db.Decimal(10, 2) // suma de cargos
  pagado           Decimal   @default(0) @db.Decimal(10, 2) // suma de cobros
  personas         Int?
  huespedDocTipo   String?   @map("huesped_doc_tipo") @db.VarChar(10) // DNI | CE | PASAPORTE
  huespedDocNumero String?   @map("huesped_doc_numero") @db.VarChar(20)
  huespedNombre    String?   @map("huesped_nombre") @db.VarChar(150)
  motivoAnulacion  String?   @map("motivo_anulacion") @db.VarChar(200)
  // R3.5: llegada de una reserva web. Su noche ya la cuenta la reserva: no suma cupo otra vez.
  pedidoId         String?   @map("pedido_id") @db.Uuid

  fechaRegistro        DateTime? @default(now()) @map("fecha_registro") @db.Timestamptz
  usuarioRegistro      String?   @map("usuario_registro") @db.VarChar(100)
  fechaActualizacion   DateTime? @map("fecha_actualizacion") @db.Timestamptz
  usuarioActualizacion String?   @map("usuario_actualizacion") @db.VarChar(100)

  habitacion hotel_habitaciones @relation(fields: [habitacionId], references: [id], onDelete: Restrict)
  pedido     pedidos?           @relation(fields: [pedidoId], references: [id], onDelete: SetNull)
  cobros     hotel_cobros[]

  @@index([tiendaId, estado], name: "idx_hotel_estadias_tienda_estado")
  @@index([habitacionId, inicio], name: "idx_hotel_estadias_habitacion")
  @@index([pedidoId], name: "idx_hotel_estadias_pedido")
}

// Recepción: cada cobro del mostrador. La caja por turno (fase 2) los agrupa.
model hotel_cobros {
  id        String   @id @default(uuid()) @db.Uuid
  tiendaId  String   @map("tienda_id") @db.Uuid
  estadiaId String   @map("estadia_id") @db.Uuid
  monto     Decimal  @db.Decimal(10, 2)
  formaPago String   @map("forma_pago") @db.VarChar(10) // efectivo | yape | plin | tarjeta
  concepto  String   @db.VarChar(100)
  fecha     DateTime @default(now()) @db.Timestamptz
  usuario   String?  @db.VarChar(100)
  // Caja (recepcion fase 2): turno en que entró la plata. null = cobro anterior a la caja.
  turnoId   String?  @map("turno_id") @db.Uuid

  estadia hotel_estadias @relation(fields: [estadiaId], references: [id], onDelete: Cascade)
  turno   hotel_turnos?  @relation(fields: [turnoId], references: [id], onDelete: Restrict)

  @@index([tiendaId, fecha], name: "idx_hotel_cobros_tienda_fecha")
  @@index([turnoId], name: "idx_hotel_cobros_turno")
}

// Recepción R5: turno de caja. Un solo cajón por tienda: a lo más un turno
// abierto (índice parcial en docs/sql/recepcion_fase_2.sql).
model hotel_turnos {
  id               String    @id @default(uuid()) @db.Uuid
  tiendaId         String    @map("tienda_id") @db.Uuid
  estado           String    @default("abierto") @db.VarChar(8) // abierto | cerrado
  abiertoEn        DateTime  @default(now()) @map("abierto_en") @db.Timestamptz
  abiertoPor       String?   @map("abierto_por") @db.VarChar(100)
  montoInicial     Decimal   @map("monto_inicial") @db.Decimal(10, 2)
  cerradoEn        DateTime? @map("cerrado_en") @db.Timestamptz
  cerradoPor       String?   @map("cerrado_por") @db.VarChar(100)
  efectivoEsperado Decimal?  @map("efectivo_esperado") @db.Decimal(10, 2)
  efectivoContado  Decimal?  @map("efectivo_contado") @db.Decimal(10, 2)
  diferencia       Decimal?  @db.Decimal(10, 2) // contado − esperado
  nota             String?   @db.VarChar(300)
  resumen          Json?     @db.JsonB // foto del turno al cerrar (totales por forma de pago, entradas, descuentos…)

  cobros      hotel_cobros[]
  movimientos hotel_caja_movimientos[]

  @@index([tiendaId, abiertoEn], name: "idx_hotel_turnos_tienda")
}

// Recepción R5.2: gastos e ingresos de caja que no son de una estadía (en efectivo).
model hotel_caja_movimientos {
  id       String   @id @default(uuid()) @db.Uuid
  tiendaId String   @map("tienda_id") @db.Uuid
  turnoId  String   @map("turno_id") @db.Uuid
  tipo     String   @db.VarChar(7) // ingreso | egreso
  monto    Decimal  @db.Decimal(10, 2)
  motivo   String   @db.VarChar(150)
  fecha    DateTime @default(now()) @db.Timestamptz
  usuario  String?  @db.VarChar(100)

  turno hotel_turnos @relation(fields: [turnoId], references: [id], onDelete: Restrict)

  @@index([turnoId], name: "idx_hotel_caja_mov_turno")
}

// Recepción R5.5: "uso sin registrar" y demás avisos para el dueño.
model hotel_incidencias {
  id           String    @id @default(uuid()) @db.Uuid
  tiendaId     String    @map("tienda_id") @db.Uuid
  habitacionId String    @map("habitacion_id") @db.Uuid
  tipo         String    @db.VarChar(20) // uso_sin_registrar
  nota         String?   @db.VarChar(200)
  fecha        DateTime  @default(now()) @db.Timestamptz
  usuario      String?   @db.VarChar(100)
  revisadaEn   DateTime? @map("revisada_en") @db.Timestamptz
  revisadaPor  String?   @map("revisada_por") @db.VarChar(100)

  habitacion hotel_habitaciones @relation(fields: [habitacionId], references: [id], onDelete: Cascade)

  @@index([tiendaId, fecha], name: "idx_hotel_incidencias_tienda")
}

// Modalidades de estadía de un tipo: noche y bloques de N horas ("fracción 6 h").
model hotel_modalidades {
  id           String   @id @default(uuid()) @db.Uuid
  tiendaId     String   @map("tienda_id") @db.Uuid
  productoId   String   @map("producto_id") @db.Uuid
  tipo         String   @db.VarChar(6) // noche | horas
  horas        Int? // solo tipo = horas
  precio       Decimal  @db.Decimal(10, 2)
  precioVieSab Decimal? @map("precio_vie_sab") @db.Decimal(10, 2) // solo noche
  activo       Boolean  @default(true)
  orden        Int      @default(0)

  tipoHabitacion hotel_tipos_habitacion @relation(fields: [productoId], references: [productoId], onDelete: Cascade)
  reservas       reservas[]

  @@index([productoId], name: "idx_hotel_modalidades_producto")
}

// Detalle de una reserva de hotel, tour o compra de entradas. El dinero, el
// cliente y el comprobante viven en `pedidos`; aquí, el servicio y el titular.
model reservas {
  pedidoId               String    @id @map("pedido_id") @db.Uuid
  tiendaId               String    @map("tienda_id") @db.Uuid
  tipo                   String    @db.VarChar(10) // hotel | tour | evento | local
  productoId             String    @map("producto_id") @db.Uuid
  modalidadId            String?   @map("modalidad_id") @db.Uuid
  inicio                 DateTime  @db.Timestamptz // ingreso / salida del tour
  fin                    DateTime? @db.Timestamptz // salida del hotel (calculada)
  noches                 Int?
  horas                  Int?
  adultos                Int?
  ninos                  Int?
  pasajeros              Json?     @db.JsonB // tours: [{ tipoId, nombre, cantidad, precio }] (snapshot)
  idioma                 String?   @db.VarChar(5) // tours: idioma elegido (es, en, ...)
  funcionId              String?   @map("funcion_id") @db.Uuid // eventos: función comprada
  // Eventos: hasta cuándo el cupo queda apartado esperando la captura del pago.
  apartadoHasta          DateTime? @map("apartado_hasta") @db.Timestamptz
  // Hotel (hospedaje-completo, fase B)
  extras                 Json?     @db.JsonB // [{ id, nombre, cobro, precio, cantidad, total, dato }] (snapshot)
  edadesNinos            Int[]     @default([]) @map("edades_ninos")
  exoneradoIgv           Boolean   @default(false) @map("exonerado_igv")
  impuestos              Json?     @db.JsonB // H2.6: { incluidos, igvPct, servicioPct, neto, igv, servicio } al reservar
  // Fase C
  habitaciones           Int       @default(1) // cuántas habitaciones del mismo tipo
  plan                   Json?     @db.JsonB // { id, nombre, ajustePct, reembolsable } (snapshot)
  idiomaHuesped          String    @default("es") @map("idioma_huesped") @db.VarChar(10) // idioma en que reservó (correos; docs/specs/idiomas)  // Alquiler de locales: inicio/fin = horario del evento SIN preparación.
  turnoId                String?   @map("turno_id") @db.Uuid
  paqueteId              String?   @map("paquete_id") @db.Uuid
  cotizacionId           String?   @map("cotizacion_id") @db.Uuid
  invitados              Int?
  tipoEvento             String?   @map("tipo_evento") @db.VarChar(20) // quinceanos | promocion | cumpleanos | boda | corporativo | conferencia | otro
  agasajado              String?   @db.VarChar(120)
  local                  Json?     @db.JsonB // snapshot: salón, turno, paquete, separación, garantía, tramos, tarifas
  contrato               Json?     @db.JsonB // { version, hash, texto, aceptadoEn, ip, adendas }
  reprogramaciones       Int       @default(0)
  saldoFavorHasta        DateTime? @map("saldo_favor_hasta") @db.Timestamptz
  invitadosConfirmadosEn DateTime? @map("invitados_confirmados_en") @db.Timestamptz
  // Alquiler de canchas: foto de la reserva (cancha, formato, duración, tramos día/noche).
  cancha                 Json?     @db.JsonB

  // Titular (registro de huésped)
  titularNombres      String    @map("titular_nombres") @db.VarChar(100)
  titularApellidos    String    @map("titular_apellidos") @db.VarChar(100)
  titularDocTipo      String?   @map("titular_doc_tipo") @db.VarChar(10) // DNI | CE | PASAPORTE; null si la tienda no lo pide
  titularDocNumero    String?   @map("titular_doc_numero") @db.VarChar(20)
  titularNacionalidad String?   @map("titular_nacionalidad") @db.VarChar(2) // ISO 3166
  horaLlegada         String?   @map("hora_llegada") @db.VarChar(5) // hora estimada de llegada (HH:mm), hotel
  titularNacimiento   DateTime? @map("titular_nacimiento") @db.Date
  acompanantes        Json?     @db.JsonB
  // Hotel (plantillas-por-rubro E8): check-in en línea { horaLlegada, comentarios, completadoEn }
  checkinOnline       Json?     @map("checkin_online") @db.JsonB
  // y la solicitud de cambio de fechas { fecha, noches, total, diferencia, disponible, motivo, comentario, solicitadoEn }
  cambioSolicitado    Json?     @map("cambio_solicitado") @db.JsonB
  comentarios         String?   @db.Text
  aceptaDatos         Boolean   @map("acepta_datos")
  aceptaTerminos      Boolean   @default(false) @map("acepta_terminos") // H4.1
  aceptaPromociones   Boolean   @default(false) @map("acepta_promociones") // H4.2: opcional, aparte de los datos (Ley 29733)

  // Ciclo de la reserva del hotel (docs/specs/ciclo-reserva-hotel)
  codigoPms   String?   @map("codigo_pms") @db.VarChar(40) // lo escribe recepción para asociarla a su PMS
  checkinEn   DateTime? @map("checkin_en") @db.Timestamptz
  checkoutEn  DateTime? @map("checkout_en") @db.Timestamptz
  notas       Json      @default("[]") @db.JsonB // [{ texto, autor, en }] para el siguiente turno; no se editan
  cancelacion Json?     @db.JsonB // { quien, motivo, penalidad, reembolso, en, usuario }
  retenido    Decimal?  @db.Decimal(10, 2) // lo que se queda el hotel al cancelar o por no-show

  // Respuesta del negocio (no hay columnas de plazo: el límite es `inicio`)
  respondidaEn  DateTime? @map("respondida_en") @db.Timestamptz
  motivoRechazo String?   @map("motivo_rechazo") @db.VarChar(200)
  ajusteMonto   Decimal?  @map("ajuste_monto") @db.Decimal(10, 2)
  ajusteMotivo  String?   @map("ajuste_motivo") @db.VarChar(200)
  montoAPagar   Decimal   @map("monto_a_pagar") @db.Decimal(10, 2)
  saldoDestino  Decimal   @default(0) @map("saldo_destino") @db.Decimal(10, 2)

  pedido    pedidos            @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  producto  productos          @relation(fields: [productoId], references: [id])
  modalidad hotel_modalidades? @relation(fields: [modalidadId], references: [id], onDelete: SetNull)
  funcion   evento_funciones?  @relation(fields: [funcionId], references: [id], onDelete: Restrict)
  turno     local_turnos?      @relation(fields: [turnoId], references: [id], onDelete: SetNull)
  paquete   local_paquetes?    @relation(fields: [paqueteId], references: [id], onDelete: SetNull)

  @@index([tiendaId, inicio], name: "idx_reservas_tienda_inicio")
  @@index([tiendaId, codigoPms], name: "idx_reservas_tienda_codigo_pms")
  @@index([funcionId], name: "idx_reservas_funcion")
  @@index([productoId, inicio], name: "idx_reservas_producto_inicio")
}

// Ficha de tour de un producto (agencia de tours, fase 2). Sin cupo por
// salida: la agencia confirma cada solicitud, como el hotel.
model tours {
  productoId     String   @id @map("producto_id") @db.Uuid
  tiendaId       String   @map("tienda_id") @db.Uuid
  duracion       String?  @db.VarChar(50) // "Full day (12 h)", "2 días / 1 noche"
  // Para saber cuándo termina (reserva completada) y para la agenda. null = termina el mismo día.
  duracionHoras  Int?     @map("duracion_horas")
  diasSalida     Int[]    @default([1, 2, 3, 4, 5, 6, 7]) @map("dias_salida") // 1 = lunes … 7 = domingo
  horasSalida    String[] @map("horas_salida") // "HH:mm"
  idiomas        String[] @default(["es"])
  itinerario     Json?    @db.JsonB // [{ dia, hora, titulo, descripcion }]
  incluye        String[] @default([])
  noIncluye      String[] @default([]) @map("no_incluye")
  queLlevar      String[] @default([]) @map("que_llevar")
  requisitos     String?  @db.Text
  puntoEncuentro String?  @map("punto_encuentro") @db.Text
  // Link de Google Maps del punto de encuentro (plantillas-por-rubro, E5)
  mapaUrl        String?  @map("mapa_url") @db.VarChar(500)
  // facil | moderado | exigente (plantillas-por-rubro, E5; CHECK en docs/sql/plantillas_datos.sql)
  dificultad     String?  @db.VarChar(15)
  recojo         String?  @db.Text // "Recojo en hoteles de Miraflores" (texto)
  edadMinima     Int?     @map("edad_minima")
  maxPasajeros   Int?     @map("max_pasajeros") // por solicitud (no es cupo de la salida)

  producto      productos             @relation(fields: [productoId], references: [id], onDelete: Cascade)
  tiposPasajero tour_tipos_pasajero[]

  @@index([tiendaId], name: "idx_tours_tienda")
}

// Precio por tipo de pasajero: "Adulto", "Niño (3-11)", "Adulto extranjero".
model tour_tipos_pasajero {
  id         String  @id @default(uuid()) @db.Uuid
  tiendaId   String  @map("tienda_id") @db.Uuid
  productoId String  @map("producto_id") @db.Uuid
  nombre     String  @db.VarChar(60)
  precio     Decimal @db.Decimal(10, 2)
  activo     Boolean @default(true)
  orden      Int     @default(0)

  tour tours @relation(fields: [productoId], references: [productoId], onDelete: Cascade)

  @@index([productoId], name: "idx_tour_tipos_producto")
}

// Ficha de evento de un producto (fase 3). A diferencia de hotel y tours, el
// cupo es real: cada tipo de entrada tiene un cupo y se vende sin confirmación.
model eventos {
  productoId  String  @id @map("producto_id") @db.Uuid
  tiendaId    String  @map("tienda_id") @db.Uuid
  lugar       String? @db.VarChar(150) // "Teatro Municipal de Lima"
  direccion   String? @db.Text
  mapaUrl     String? @map("mapa_url") @db.VarChar(500) // link de Google Maps
  edadMinima  Int?    @map("edad_minima")
  organizador String? @db.VarChar(150) // productora o responsable visible al comprador
  // Evento de un cliente (cumpleaños, boda): no sale en la vitrina, la búsqueda
  // ni el asesor, y no vende entradas. Se ve solo con una invitación a su
  // transmisión (docs/specs/transmision-eventos, R1.4).
  privado     Boolean @default(false)

  producto  productos          @relation(fields: [productoId], references: [id], onDelete: Cascade)
  funciones evento_funciones[]

  @@index([tiendaId], name: "idx_eventos_tienda")
}

// Fecha y hora de un evento ("Sábado 18:00", "Función de noche").
model evento_funciones {
  id         String    @id @default(uuid()) @db.Uuid
  tiendaId   String    @map("tienda_id") @db.Uuid
  productoId String    @map("producto_id") @db.Uuid
  nombre     String?   @db.VarChar(80)
  inicio     DateTime  @db.Timestamptz
  fin        DateTime? @db.Timestamptz // null = se asume inicio + 6 h
  activa     Boolean   @default(true)

  evento       eventos                @relation(fields: [productoId], references: [productoId], onDelete: Cascade)
  tiposEntrada evento_tipos_entrada[]
  reservas     reservas[]
  transmision  evento_transmisiones?

  @@index([productoId, inicio], name: "idx_evento_funciones_evento")
  @@index([tiendaId, inicio], name: "idx_evento_funciones_tienda")
}

// Tipo de entrada de una función: precio y cupo ("General", "VIP", "Preventa").
model evento_tipos_entrada {
  id          String    @id @default(uuid()) @db.Uuid
  tiendaId    String    @map("tienda_id") @db.Uuid
  funcionId   String    @map("funcion_id") @db.Uuid
  nombre      String    @db.VarChar(80)
  descripcion String?   @db.VarChar(200)
  precio      Decimal   @db.Decimal(10, 2)
  cupo        Int
  // Confirmadas. Lo apartado (compras sin pagar o en revisión) se calcula aparte.
  vendidos    Int       @default(0)
  ventaHasta  DateTime? @map("venta_hasta") @db.Timestamptz // null = hasta el inicio de la función
  activo      Boolean   @default(true)
  orden       Int       @default(0)

  funcion evento_funciones      @relation(fields: [funcionId], references: [id], onDelete: Cascade)
  items   evento_compra_items[]

  @@index([funcionId], name: "idx_evento_tipos_funcion")
}

// Entradas de una compra (snapshot de nombre y precio). El cupo apartado es la
// suma de los items de compras `por_pagar` vigentes o `pago_en_revision`.
model evento_compra_items {
  id            String  @id @default(uuid()) @db.Uuid
  tiendaId      String  @map("tienda_id") @db.Uuid
  pedidoId      String  @map("pedido_id") @db.Uuid
  tipoEntradaId String  @map("tipo_entrada_id") @db.Uuid
  nombre        String  @db.VarChar(80)
  cantidad      Int
  precio        Decimal @db.Decimal(10, 2)

  pedido      pedidos              @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  tipoEntrada evento_tipos_entrada @relation(fields: [tipoEntradaId], references: [id], onDelete: Restrict)

  @@index([tipoEntradaId], name: "idx_evento_items_tipo")
  @@index([pedidoId], name: "idx_evento_items_pedido")
}

// Pago dividido de una cancha (docs/specs/plantillas-por-rubro E7): cada jugador paga
// su parte por link con la pasarela. DDL: docs/sql/pago_dividido.sql
model reserva_partes {
  id            String    @id @default(uuid()) @db.Uuid
  tiendaId      String    @map("tienda_id") @db.Uuid
  pedidoId      String    @map("pedido_id") @db.Uuid
  numero        Int
  monto         Decimal   @db.Decimal(10, 2)
  estado        String    @default("pendiente") @db.VarChar(15) // pendiente | pagada
  pagadaEn      DateTime? @map("pagada_en") @db.Timestamptz
  fechaRegistro DateTime? @default(now()) @map("fecha_registro") @db.Timestamptz

  pedido pedidos @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  pagos  pagos[]

  @@index([pedidoId], name: "idx_reserva_partes_pedido")
}

// Entrada con QR por persona (docs/specs/plantillas-por-rubro E6): se emite al
// confirmar la compra y se marca usada en la puerta. DDL: docs/sql/entradas_qr.sql
model evento_entradas {
  id            String    @id @default(uuid()) @db.Uuid
  tiendaId      String    @map("tienda_id") @db.Uuid
  pedidoId      String    @map("pedido_id") @db.Uuid
  funcionId     String?   @map("funcion_id") @db.Uuid
  tipoEntradaId String    @map("tipo_entrada_id") @db.Uuid
  tipoNombre    String    @map("tipo_nombre") @db.VarChar(80)
  numero        Int // 1..N dentro de la compra
  codigo        String    @unique @db.VarChar(12)
  usadaEn       DateTime? @map("usada_en") @db.Timestamptz
  usadaPor      String?   @map("usada_por") @db.VarChar(100)
  anulada       Boolean   @default(false)
  fechaRegistro DateTime? @default(now()) @map("fecha_registro") @db.Timestamptz

  pedido pedidos @relation(fields: [pedidoId], references: [id], onDelete: Cascade)

  @@index([pedidoId], name: "idx_evento_entradas_pedido")
  @@index([tiendaId, funcionId], name: "idx_evento_entradas_funcion")
}

// ============================================
// MÓDULO: ALQUILER DE LOCALES (docs/specs/alquiler-locales)
// Un salón es un `productos` + su ficha 1:1 en `local_salones`, con turnos y
// paquetes. La reserva es un `pedidos` tipo = 'local' + `reservas`. La
// disponibilidad la garantiza `local_ocupaciones` con una restricción de
// exclusión sobre la franja (solo en SQL). DDL: docs/sql/locales_fase_1.sql
// ============================================

model local_salones {
  productoId     String   @id @map("producto_id") @db.Uuid
  tiendaId       String   @map("tienda_id") @db.Uuid
  metros         Int?
  aforoMaximo    Int      @map("aforo_maximo") // el de la licencia / ITSE (R2.2)
  // Personas sentadas (banquete); el máximo de la licencia es de pie (cóctel). null = no se informa (plantillas-por-rubro, E5)
  aforoSentados  Int?     @map("aforo_sentados")
  preparacionMin Int      @default(60) @map("preparacion_min") // antes y después de cada reserva (R2.4)
  porHoras       Boolean  @default(false) @map("por_horas")
  precioHora     Decimal? @map("precio_hora") @db.Decimal(10, 2)
  minHoras       Int?     @map("min_horas")
  horasDesde     String?  @map("horas_desde") @db.VarChar(5) // franja en que se alquila por horas
  horasHasta     String?  @map("horas_hasta") @db.VarChar(5)
  servicios      String[] @default([]) // mesas, sillas, cocina, barra, sonido_dj, estacionamiento…

  fechaRegistro        DateTime? @default(now()) @map("fecha_registro") @db.Timestamptz
  usuarioRegistro      String?   @map("usuario_registro") @db.VarChar(100)
  fechaActualizacion   DateTime? @map("fecha_actualizacion") @db.Timestamptz
  usuarioActualizacion String?   @map("usuario_actualizacion") @db.VarChar(100)

  producto     productos            @relation(fields: [productoId], references: [id], onDelete: Cascade)
  turnos       local_turnos[]
  paquetes     local_paquetes[]
  ocupaciones  local_ocupaciones[]
  cotizaciones local_cotizaciones[]

  @@index([tiendaId], name: "idx_local_salones_tienda")
}

// Turno de un salón ("Noche 19:00–03:00"). Fin menor que inicio = termina al día siguiente.
model local_turnos {
  id         String  @id @default(uuid()) @db.Uuid
  tiendaId   String  @map("tienda_id") @db.Uuid
  productoId String  @map("producto_id") @db.Uuid
  nombre     String  @db.VarChar(60)
  horaInicio String  @map("hora_inicio") @db.VarChar(5)
  horaFin    String  @map("hora_fin") @db.VarChar(5)
  diasSemana Int[]   @default([1, 2, 3, 4, 5, 6, 7]) @map("dias_semana") // 1 = lunes … 7 = domingo
  precios    Json    @db.JsonB // precio "solo local": { lj, v, s, d, f }
  activo     Boolean @default(true)
  orden      Int     @default(0)

  fechaRegistro        DateTime? @default(now()) @map("fecha_registro") @db.Timestamptz
  usuarioRegistro      String?   @map("usuario_registro") @db.VarChar(100)
  fechaActualizacion   DateTime? @map("fecha_actualizacion") @db.Timestamptz
  usuarioActualizacion String?   @map("usuario_actualizacion") @db.VarChar(100)

  salon    local_salones @relation(fields: [productoId], references: [productoId], onDelete: Cascade)
  reservas reservas[]

  @@index([productoId], name: "idx_local_turnos_salon")
}

// Paquete de un salón: solo_local (precio del turno), paquete (fijo o por persona) o por_horas.
model local_paquetes {
  id              String   @id @default(uuid()) @db.Uuid
  tiendaId        String   @map("tienda_id") @db.Uuid
  productoId      String   @map("producto_id") @db.Uuid
  nombre          String   @db.VarChar(80)
  descripcion     String?  @db.VarChar(300)
  modalidad       String   @db.VarChar(12) // solo_local | paquete | por_horas
  precioTipo      String   @default("fijo") @map("precio_tipo") @db.VarChar(12) // fijo | por_persona
  precios         Json?    @db.JsonB // { lj, v, s, d, f }; null en solo_local y por_horas
  minPersonas     Int?     @map("min_personas")
  maxPersonas     Int?     @map("max_personas")
  incluye         String[] @default([])
  horasIncluidas  Int?     @map("horas_incluidas")
  horaExtraPrecio Decimal? @map("hora_extra_precio") @db.Decimal(10, 2)
  tiposEvento     String[] @default([]) @map("tipos_evento") // vacío = todos
  esPromocion     Boolean  @default(false) @map("es_promocion") // R13
  turnoIds        String[] @default([]) @map("turno_ids") @db.Uuid // vacío = todos
  activo          Boolean  @default(true)
  orden           Int      @default(0)
  traducciones    Json?    @db.JsonB

  fechaRegistro        DateTime? @default(now()) @map("fecha_registro") @db.Timestamptz
  usuarioRegistro      String?   @map("usuario_registro") @db.VarChar(100)
  fechaActualizacion   DateTime? @map("fecha_actualizacion") @db.Timestamptz
  usuarioActualizacion String?   @map("usuario_actualizacion") @db.VarChar(100)

  salon    local_salones @relation(fields: [productoId], references: [productoId], onDelete: Cascade)
  reservas reservas[]

  @@index([productoId], name: "idx_local_paquetes_salon")
}

// Franja ocupada de un salón: solicitud, apartado, reserva o bloqueo manual.
// `franja` es una columna generada (tstzrange) con la restricción de exclusión
// ex_local_ocupacion: dos filas activas del mismo salón no se cruzan (CE-01).
// Una fila con `expira_en` vencido no ocupa: se desactiva en la transacción
// que vuelve a tocar el salón y las lecturas la ignoran.
model local_ocupaciones {
  id              String                    @id @default(uuid()) @db.Uuid
  tiendaId        String                    @map("tienda_id") @db.Uuid
  productoId      String                    @map("producto_id") @db.Uuid
  pedidoId        String?                   @map("pedido_id") @db.Uuid // null = bloqueo manual
  tipo            String                    @db.VarChar(10) // solicitud | apartado | reserva | bloqueo
  inicio          DateTime                  @db.Timestamptz // ya incluye la preparación (R3.3)
  fin             DateTime                  @db.Timestamptz
  franja          Unsupported("tstzrange")?
  expiraEn        DateTime?                 @map("expira_en") @db.Timestamptz
  activo          Boolean                   @default(true)
  motivo          String?                   @db.VarChar(100) // bloqueos manuales (solo admin)
  fechaRegistro   DateTime?                 @default(now()) @map("fecha_registro") @db.Timestamptz
  usuarioRegistro String?                   @map("usuario_registro") @db.VarChar(100)

  salon  local_salones @relation(fields: [productoId], references: [productoId], onDelete: Cascade)
  pedido pedidos?      @relation(fields: [pedidoId], references: [id], onDelete: Cascade)

  @@index([productoId, inicio], name: "idx_local_ocupaciones_salon")
  @@index([tiendaId, inicio], name: "idx_local_ocupaciones_tienda")
  @@index([pedidoId], name: "idx_local_ocupaciones_pedido")
}

// Plan de pagos de una reserva de local (R7): separación, cuotas, saldo, garantía y cargos.
model reserva_cuotas {
  id             String    @id @default(uuid()) @db.Uuid
  tiendaId       String    @map("tienda_id") @db.Uuid
  pedidoId       String    @map("pedido_id") @db.Uuid
  participanteId String?   @map("participante_id") @db.Uuid // promoción (fase 3)
  numero         Int
  concepto       String    @db.VarChar(20) // separacion | cuota | saldo | garantia | hora_extra | descorche | danos | penalidad | diferencia | cargo_reprogramacion
  monto          Decimal   @db.Decimal(10, 2)
  venceEn        DateTime  @map("vence_en") @db.Date
  estado         String    @default("pendiente") @db.VarChar(12) // pendiente | en_revision | pagada | anulada
  pagadaEn       DateTime? @map("pagada_en") @db.Timestamptz
  recordatorios  Json      @default("{}") @db.JsonB // { d7, d3, d1 } (R14.7)
  idempotencyKey String?   @map("idempotency_key") @db.Uuid

  fechaRegistro        DateTime? @default(now()) @map("fecha_registro") @db.Timestamptz
  usuarioRegistro      String?   @map("usuario_registro") @db.VarChar(100)
  fechaActualizacion   DateTime? @map("fecha_actualizacion") @db.Timestamptz
  usuarioActualizacion String?   @map("usuario_actualizacion") @db.VarChar(100)

  pedido pedidos @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  pagos  pagos[]

  @@unique([pedidoId, numero], name: "uq_cuota_numero")
  @@unique([tiendaId, idempotencyKey], name: "uq_cuota_idempotency")
  @@index([tiendaId, estado, venceEn], name: "idx_cuotas_vencimiento")
}

// Historial de cambios de una reserva de local: reprogramación, suspensión, ajustes, adendas.
model reserva_cambios {
  id              String    @id @default(uuid()) @db.Uuid
  tiendaId        String    @map("tienda_id") @db.Uuid
  pedidoId        String    @map("pedido_id") @db.Uuid
  tipo            String    @db.VarChar(20) // reprogramacion | suspension | ajuste_monto | ajuste_plan | adenda | cancelacion
  antes           Json?     @db.JsonB
  despues         Json?     @db.JsonB
  actor           String    @db.VarChar(10) // cliente | negocio
  motivo          String?   @db.VarChar(30)
  nota            String?   @db.VarChar(300)
  diferencia      Decimal?  @db.Decimal(10, 2)
  estado          String    @default("aplicado") @db.VarChar(12) // pedido | aplicado | rechazado
  fechaRegistro   DateTime? @default(now()) @map("fecha_registro") @db.Timestamptz
  usuarioRegistro String?   @map("usuario_registro") @db.VarChar(100)

  pedido pedidos @relation(fields: [pedidoId], references: [id], onDelete: Cascade)

  @@index([pedidoId], name: "idx_reserva_cambios_pedido")
}

// Cotización guardada con precio congelado hasta su vencimiento (R4). Se abre por token firmado.
model local_cotizaciones {
  id              String    @id @default(uuid()) @db.Uuid
  tiendaId        String    @map("tienda_id") @db.Uuid
  productoId      String    @map("producto_id") @db.Uuid
  turnoId         String?   @map("turno_id") @db.Uuid
  paqueteId       String?   @map("paquete_id") @db.Uuid
  fecha           DateTime  @db.Date
  horaInicio      String    @map("hora_inicio") @db.VarChar(5)
  horaFin         String    @map("hora_fin") @db.VarChar(5)
  invitados       Int
  tipoEvento      String    @map("tipo_evento") @db.VarChar(20)
  detalle         Json      @db.JsonB // líneas, total, separación, garantía (precio congelado)
  total           Decimal   @db.Decimal(10, 2)
  venceEn         DateTime  @map("vence_en") @db.Timestamptz
  canalOrigen     String?   @map("canal_origen") @db.VarChar(20) // tiktok | instagram | facebook | google | portal | recomendacion | cartel | otro
  creadaPor       String    @map("creada_por") @db.VarChar(10) // cliente | negocio
  ajusteMonto     Decimal?  @map("ajuste_monto") @db.Decimal(10, 2)
  ajusteMotivo    String?   @map("ajuste_motivo") @db.VarChar(200)
  clienteNombre   String?   @map("cliente_nombre") @db.VarChar(100)
  clienteWhatsapp String?   @map("cliente_whatsapp") @db.VarChar(20)
  clienteEmail    String?   @map("cliente_email") @db.VarChar(100)
  pedidoId        String?   @map("pedido_id") @db.Uuid // la solicitud que la usó
  recordatorioEn  DateTime? @map("recordatorio_en") @db.Timestamptz

  fechaRegistro        DateTime? @default(now()) @map("fecha_registro") @db.Timestamptz
  usuarioRegistro      String?   @map("usuario_registro") @db.VarChar(100)
  fechaActualizacion   DateTime? @map("fecha_actualizacion") @db.Timestamptz
  usuarioActualizacion String?   @map("usuario_actualizacion") @db.VarChar(100)

  salon  local_salones @relation(fields: [productoId], references: [productoId], onDelete: Cascade)
  pedido pedidos?      @relation(fields: [pedidoId], references: [id], onDelete: SetNull)

  @@index([tiendaId, fechaRegistro(sort: Desc)], name: "idx_local_cotizaciones_tienda")
  @@index([productoId], name: "idx_local_cotizaciones_salon")
  @@index([pedidoId], name: "idx_local_cotizaciones_pedido")
}

// ============================================
// MÓDULO: ALQUILER DE CANCHAS (docs/specs/alquiler-canchas)
// Una cancha es un `productos` + su ficha 1:1 en `cancha_canchas` (formato y
// precio por hora de día y de noche). La reserva es un `pedidos` tipo =
// 'cancha' + `reservas`. La disponibilidad la garantiza `cancha_ocupaciones`
// con una restricción de exclusión sobre la franja (solo en SQL).
// DDL: docs/sql/canchas_fase_1.sql
// ============================================

model cancha_canchas {
  productoId   String  @id @map("producto_id") @db.Uuid
  tiendaId     String  @map("tienda_id") @db.Uuid
  formato      String  @db.VarChar(4) // F5 | F6 | F7 | F8 | F9 | F11
  largoM       Int?    @map("largo_m")
  anchoM       Int?    @map("ancho_m")
  jugadoresMax Int     @map("jugadores_max")
  techada      Boolean @default(false)
  superficie   String? @db.VarChar(60) // "Grass sintético 50 mm"
  precioDia    Decimal @map("precio_dia") @db.Decimal(10, 2) // por hora
  precioNoche  Decimal @map("precio_noche") @db.Decimal(10, 2) // por hora, desde config_reservas.cancha_inicio_noche

  fechaRegistro        DateTime? @default(now()) @map("fecha_registro") @db.Timestamptz
  usuarioRegistro      String?   @map("usuario_registro") @db.VarChar(100)
  fechaActualizacion   DateTime? @map("fecha_actualizacion") @db.Timestamptz
  usuarioActualizacion String?   @map("usuario_actualizacion") @db.VarChar(100)

  producto    productos            @relation(fields: [productoId], references: [id], onDelete: Cascade)
  ocupaciones cancha_ocupaciones[]

  @@index([tiendaId], name: "idx_cancha_canchas_tienda")
}

// Franja ocupada de una cancha: apartado (esperando el pago), reserva o bloqueo
// manual. `franja` es una columna generada (tstzrange) con la restricción de
// exclusión ex_cancha_ocupacion: dos filas activas de la misma cancha no se
// cruzan (R4). Una fila con `expira_en` vencido no ocupa.
model cancha_ocupaciones {
  id              String                    @id @default(uuid()) @db.Uuid
  tiendaId        String                    @map("tienda_id") @db.Uuid
  productoId      String                    @map("producto_id") @db.Uuid
  pedidoId        String?                   @map("pedido_id") @db.Uuid // null = bloqueo manual
  tipo            String                    @db.VarChar(10) // apartado | reserva | bloqueo
  inicio          DateTime                  @db.Timestamptz
  fin             DateTime                  @db.Timestamptz
  franja          Unsupported("tstzrange")?
  expiraEn        DateTime?                 @map("expira_en") @db.Timestamptz
  activo          Boolean                   @default(true)
  motivo          String?                   @db.VarChar(100) // bloqueos manuales (solo admin)
  fechaRegistro   DateTime?                 @default(now()) @map("fecha_registro") @db.Timestamptz
  usuarioRegistro String?                   @map("usuario_registro") @db.VarChar(100)

  cancha cancha_canchas @relation(fields: [productoId], references: [productoId], onDelete: Cascade)
  pedido pedidos?       @relation(fields: [pedidoId], references: [id], onDelete: Cascade)

  @@index([productoId, inicio], name: "idx_cancha_ocupaciones_cancha")
  @@index([tiendaId, inicio], name: "idx_cancha_ocupaciones_tienda")
  @@index([pedidoId], name: "idx_cancha_ocupaciones_pedido")
}

// ============================================
// MÓDULO: TRANSMISIÓN DE EVENTOS (docs/specs/transmision-eventos)
// Una transmisión por función de un evento. Fase 1: plan Básico (YouTube
// "no listado" incrustado en una página privada). Los invitados entran con un
// enlace firmado por invitado (/:slug/t/:token). DDL: docs/sql/transmisiones_setup.sql
// ============================================
model evento_transmisiones {
  id        String @id @default(uuid()) @db.Uuid
  tiendaId  String @map("tienda_id") @db.Uuid
  funcionId String @unique @map("funcion_id") @db.Uuid

  plan   String @default("basico") @db.VarChar(20) // basico | privado | premium
  estado String @default("programada") @db.VarChar(20) // programada | cancelada (las etapas en vivo salen de la hora)

  // Duración contratada. Copia de (fin - inicio) de la función, o la que indica
  // el admin si la función no tiene fin (R1.2).
  duracionMin    Int     @map("duracion_min")
  // Plan Básico: id del video de YouTube que se incrusta.
  youtubeVideoId String? @map("youtube_video_id") @db.VarChar(20)

  // Plan Privado (Fase 2): video propio en Cloudflare Stream.
  proveedor            String?   @db.VarChar(20) // cloudflare
  entradaId            String?   @map("entrada_id") @db.VarChar(64) // live input del proveedor
  // Datos de conexión (URL RTMPS, clave, SRT) cifrados con utils/crypto.js (R9.4).
  claveCifrada         String?   @map("clave_cifrada") @db.Text
  // Sube al regenerar la clave: invalida las sesiones de la App Transmitir.
  claveVersion         Int       @default(1) @map("clave_version")
  // Tope de invitados (25 | 50 | 100 | 200) y su factor de descuento (0.5 | 1 | 2 | 4).
  maxInvitados         Int?      @map("max_invitados")
  factor               Decimal?  @db.Decimal(3, 1)
  // La entrada solo acepta señal en la prueba y en la ventana del evento (la maneja el job).
  habilitada           Boolean   @default(false)
  pruebaHasta          DateTime? @map("prueba_hasta") @db.Timestamptz
  // Señal que llega del celular: sin_senal | conectada | desconectada
  senal                String    @default("sin_senal") @db.VarChar(20)
  senalEn              DateTime? @map("senal_en") @db.Timestamptz
  // Última vez que un aviso del proveedor o la API confirmó la señal: el job no la consulta si es reciente.
  senalVerificadaEn    DateTime? @map("senal_verificada_en") @db.Timestamptz
  // Problema de la señal (código de live_input.errored, ej. ERR_GOP_OUT_OF_RANGE). Se limpia al conectar.
  senalError           String?   @map("senal_error") @db.VarChar(40)
  senalErrorEn         DateTime? @map("senal_error_en") @db.Timestamptz
  inicioRealEn         DateTime? @map("inicio_real_en") @db.Timestamptz
  // Corte (job, a los 5 min del fin) o "Terminar" del admin (R6.3, R7.8).
  terminadaEn          DateTime? @map("terminada_en") @db.Timestamptz
  minutosUsados        Int?      @map("minutos_usados")
  minutosDescontados   Int?      @map("minutos_descontados")
  // Fase 3: minutos extra confirmados (R7.5-R7.7) y extensión automática autorizada al activar (0, 30 o 60).
  extensionMin         Int       @default(0) @map("extension_min")
  extensionAutoMaxMin  Int       @default(0) @map("extension_auto_max_min")
  // "Terminar a la hora": no se aplica la extensión automática.
  noExtender           Boolean   @default(false) @map("no_extender")
  // Aviso de los 15 minutos (se vuelve a enviar tras cada extensión).
  avisoFinEn           DateTime? @map("aviso_fin_en") @db.Timestamptz
  // Contacto de la transmisión: otro celular que recibe el aviso (el que transmite está en No molestar).
  contactoNombre       String?   @map("contacto_nombre") @db.VarChar(100)
  contactoEmail        String?   @map("contacto_email") @db.VarChar(150)
  contactoTelefono     String?   @map("contacto_telefono") @db.VarChar(20)
  // Minutos vistos estimados con el latido de los invitados (costo real, R10.3).
  minutosVistos        Decimal   @default(0) @map("minutos_vistos") @db.Decimal(10, 1)
  // Fase 4: grabación (R8.1). Privado: 30 días en línea + descarga, incluida y
  // activada por defecto; false = "Solo en vivo". "Guardar 1 año" alarga solo la
  // descarga (MP4 copiado a R2 privado).
  grabar               Boolean   @default(true)
  guardarAnio          Boolean   @default(false) @map("guardar_anio")
  avisoGrabacionEn     DateTime? @map("aviso_grabacion_en") @db.Timestamptz
  avisoBorradoEn       DateTime? @map("aviso_borrado_en") @db.Timestamptz
  avisoDescargaEn      DateTime? @map("aviso_descarga_en") @db.Timestamptz
  grabacionBorradaEn   DateTime? @map("grabacion_borrada_en") @db.Timestamptz
  // Fase 5 (Premium): resumen con IA de la grabación (R8.3).
  // pendiente | generando | listo | error | sin_audio
  resumenEstado        String?   @map("resumen_estado") @db.VarChar(20)
  // { resumen, capitulos: [{ inicioSeg, titulo }], momentos: [{ inicioSeg, descripcion }] }
  resumen              Json?     @db.JsonB
  resumenGeneradoEn    DateTime? @map("resumen_generado_en") @db.Timestamptz
  resumenIntentos      Int       @default(0) @map("resumen_intentos")
  resumenTokensEntrada Int?      @map("resumen_tokens_entrada")
  resumenTokensSalida  Int?      @map("resumen_tokens_salida")
  avisoResumenEn       DateTime? @map("aviso_resumen_en") @db.Timestamptz
  // La IA solo corre a pedido: quién apretó "Generar resumen" y cuándo (decisión 2026-10-15).
  resumenPedidoEn      DateTime? @map("resumen_pedido_en") @db.Timestamptz
  resumenPedidoPor     String?   @map("resumen_pedido_por") @db.VarChar(100)
  // Entrada borrada en el proveedor (las grabaciones se conservan aparte).
  limpiadaEn           DateTime? @map("limpiada_en") @db.Timestamptz

  // Consentimiento del anfitrión (R9.1, Ley 29733): sin él no se activa.
  anfitrionNombre   String   @map("anfitrion_nombre") @db.VarChar(150)
  anfitrionEmail    String?  @map("anfitrion_email") @db.VarChar(150)
  consentimientoEn  DateTime @map("consentimiento_en") @db.Timestamptz
  consentimientoPor String   @map("consentimiento_por") @db.VarChar(100)

  // Auditoría
  fechaRegistro        DateTime? @default(now()) @map("fecha_registro") @db.Timestamptz
  usuarioRegistro      String?   @map("usuario_registro") @db.VarChar(100)
  fechaActualizacion   DateTime? @map("fecha_actualizacion") @db.Timestamptz
  usuarioActualizacion String?   @map("usuario_actualizacion") @db.VarChar(100)

  funcion       evento_funciones            @relation(fields: [funcionId], references: [id], onDelete: Cascade)
  invitaciones  evento_invitaciones[]
  vinculaciones transmision_vinculaciones[]
  movimientos   transmision_movimientos[]
  excedente     transmision_excedentes?
  grabaciones   transmision_grabaciones[]
  cargos        transmision_cargos[]
  destinos      transmision_destinos[]

  @@index([tiendaId], name: "idx_evento_transmisiones_tienda")
}

// Un enlace por invitado (siempre nominativo, decisión 2026-10-06). El token
// firmado lleva el id y la versión: regenerar sube la versión y el enlace
// anterior deja de servir. Las fechas en que vale se leen de la transmisión.
model evento_invitaciones {
  id            String @id @default(uuid()) @db.Uuid
  tiendaId      String @map("tienda_id") @db.Uuid
  transmisionId String @map("transmision_id") @db.Uuid

  nombre   String  @db.VarChar(100)
  telefono String? @db.VarChar(20)
  estado   String  @default("activa") @db.VarChar(20) // activa | anulada
  version  Int     @default(1)

  primeraConexionEn DateTime? @map("primera_conexion_en") @db.Timestamptz
  ultimaConexionEn  DateTime? @map("ultima_conexion_en") @db.Timestamptz
  // Una sola sesión por enlace (R4.3): el último dispositivo que la reclama gana.
  sesionId          String?   @map("sesion_id") @db.VarChar(40)
  sesionVistaEn     DateTime? @map("sesion_vista_en") @db.Timestamptz
  // Calidad que vio este invitado en vivo (lo mide su reproductor y llega con el latido):
  // segundos en pausa esperando video, segundos viendo y cuántas veces se cortó.
  pausaSeg          Decimal   @default(0) @map("pausa_seg") @db.Decimal(10, 1)
  vistoSeg          Decimal   @default(0) @map("visto_seg") @db.Decimal(10, 1)
  cortes            Int       @default(0)
  ultimoCorteEn     DateTime? @map("ultimo_corte_en") @db.Timestamptz

  // Auditoría
  fechaRegistro        DateTime? @default(now()) @map("fecha_registro") @db.Timestamptz
  usuarioRegistro      String?   @map("usuario_registro") @db.VarChar(100)
  fechaActualizacion   DateTime? @map("fecha_actualizacion") @db.Timestamptz
  usuarioActualizacion String?   @map("usuario_actualizacion") @db.VarChar(100)

  transmision evento_transmisiones @relation(fields: [transmisionId], references: [id], onDelete: Cascade)

  @@index([transmisionId], name: "idx_evento_invitaciones_transmision")
  @@index([tiendaId], name: "idx_evento_invitaciones_tienda")
}

// Webhooks del proveedor de video (Cloudflare Stream y Notifications). El par
// (proveedor, eventoId) único garantiza idempotencia, como pago_eventos (R10.2).
model transmision_eventos_proveedor {
  id            String    @id @default(uuid()) @db.Uuid
  proveedor     String    @db.VarChar(20)
  eventoId      String    @map("evento_id") @db.VarChar(120)
  tipo          String    @db.VarChar(60)
  entradaId     String?   @map("entrada_id") @db.VarChar(64)
  payload       Json?     @db.JsonB
  fechaRegistro DateTime? @default(now()) @map("fecha_registro") @db.Timestamptz

  @@unique([proveedor, eventoId], name: "uq_transmision_evento_proveedor")
}

// Parámetros de la plataforma que su administrador cambia sin deploy
// (modules/parametros). La lista de claves, su validación y su valor por
// defecto viven en parametros.registro.js; aquí solo lo que alguien cambió.
model parametros_plataforma {
  clave                String    @id @db.VarChar(60)
  valor                Json      @db.JsonB
  fechaRegistro        DateTime? @default(now()) @map("fecha_registro") @db.Timestamptz
  usuarioRegistro      String?   @map("usuario_registro") @db.VarChar(100)
  fechaActualizacion   DateTime? @map("fecha_actualizacion") @db.Timestamptz
  usuarioActualizacion String?   @map("usuario_actualizacion") @db.VarChar(100)
}

// Avisos a la plataforma (almacenamiento de video casi lleno o lleno). La clave
// única ("cuota-80:2026-10-15") hace que cada aviso salga una sola vez, aunque
// corran varias réplicas o el proceso se reinicie. Sirve a cualquier aviso de la
// plataforma (modules/plataforma/avisos.js); la tabla conserva su nombre original.
model avisos_plataforma {
  id            String    @id @default(uuid()) @db.Uuid
  clave         String    @unique @db.VarChar(80)
  detalle       Json?     @db.JsonB
  fechaRegistro DateTime? @default(now()) @map("fecha_registro") @db.Timestamptz

  @@map("transmision_avisos_plataforma")
}

// ── Campañas: fechas por año (docs/specs/campanas-cuando R2; docs/sql/campanas_ediciones.sql) ──

// Ediciones de las campañas del catálogo cuya fecha no se calcula (Cyber Wow). Las
// carga el administrador de la plataforma. Sin tienda_id: son de la plataforma.
// Qué ediciones se esperan cada año vive en modules/campanas/presets.js.
model campana_ediciones {
  id          String    @id @default(uuid()) @db.Uuid
  presetId    String    @map("preset_id") @db.VarChar(60)
  anio        Int       @db.SmallInt
  clave       String    @db.VarChar(30)
  nombre      String    @db.VarChar(60)
  fechaInicio DateTime  @map("fecha_inicio") @db.Date
  horaInicio  DateTime? @map("hora_inicio") @db.Time(6)
  fechaFin    DateTime  @map("fecha_fin") @db.Date
  horaFin     DateTime? @map("hora_fin") @db.Time(6)
  fuente      String?   @db.VarChar(500)

  // Auditoría
  fechaRegistro        DateTime? @default(now()) @map("fecha_registro") @db.Timestamptz
  usuarioRegistro      String?   @map("usuario_registro") @db.VarChar(100)
  fechaActualizacion   DateTime? @map("fecha_actualizacion") @db.Timestamptz
  usuarioActualizacion String?   @map("usuario_actualizacion") @db.VarChar(100)

  historial campana_ediciones_historial[]

  @@unique([presetId, anio, clave], map: "uq_campana_ediciones")
}

// Quién cargó, cambió o borró cada edición, con el valor anterior y el nuevo (R2.7).
model campana_ediciones_historial {
  id        String   @id @default(uuid()) @db.Uuid
  edicionId String?  @map("edicion_id") @db.Uuid
  presetId  String   @map("preset_id") @db.VarChar(60)
  anio      Int      @db.SmallInt
  clave     String   @db.VarChar(30)
  accion    String   @db.VarChar(10)
  antes     Json?    @db.JsonB
  despues   Json?    @db.JsonB
  usuario   String   @db.VarChar(100)
  fecha     DateTime @default(now()) @db.Timestamptz

  edicion campana_ediciones? @relation(fields: [edicionId], references: [id], onDelete: SetNull)

  @@index([presetId, anio, clave, fecha(sort: Desc)], map: "idx_campana_ediciones_historial")
}

// Código de un solo uso del QR "Transmitir con este celular" (App Transmitir,
// R11.1). Se guarda solo el hash. Vence a los 10 minutos.
model transmision_vinculaciones {
  id              String    @id @default(uuid()) @db.Uuid
  tiendaId        String    @map("tienda_id") @db.Uuid
  transmisionId   String    @map("transmision_id") @db.Uuid
  codigoHash      String    @unique @map("codigo_hash") @db.VarChar(64)
  venceEn         DateTime  @map("vence_en") @db.Timestamptz
  usadoEn         DateTime? @map("usado_en") @db.Timestamptz
  fechaRegistro   DateTime? @default(now()) @map("fecha_registro") @db.Timestamptz
  usuarioRegistro String?   @map("usuario_registro") @db.VarChar(100)

  transmision evento_transmisiones @relation(fields: [transmisionId], references: [id], onDelete: Cascade)

  @@index([transmisionId], name: "idx_transmision_vinculaciones_transmision")
}

// ============================================
// TRANSMISIÓN: paquetes de horas, movimientos y excedente (Fase 3, cobro manual)
// Todo en minutos "de paquete" (minutos transmitidos × factor del tope).
// ============================================

// Paquete prepagado (10 h o 25 h). Lo da de alta la plataforma tras cobrarlo a
// mano (scripts/transmision-paquete.js). Vence a los 12 meses (R7.4).
model transmision_paquetes {
  id             String   @id @default(uuid()) @db.Uuid
  tiendaId       String   @map("tienda_id") @db.Uuid
  minutos        Int
  minutosUsados  Int      @default(0) @map("minutos_usados")
  precio         Decimal  @db.Decimal(10, 2)
  moneda         String   @default("PEN") @db.VarChar(3)
  referenciaPago String?  @map("referencia_pago") @db.VarChar(120) // "Yape 123456", "Transferencia BCP …"
  compradoEn     DateTime @default(now()) @map("comprado_en") @db.Timestamptz
  venceEn        DateTime @map("vence_en") @db.Timestamptz
  estado         String   @default("activo") @db.VarChar(20) // activo | anulado

  // Auditoría
  fechaRegistro        DateTime? @default(now()) @map("fecha_registro") @db.Timestamptz
  usuarioRegistro      String?   @map("usuario_registro") @db.VarChar(100)
  fechaActualizacion   DateTime? @map("fecha_actualizacion") @db.Timestamptz
  usuarioActualizacion String?   @map("usuario_actualizacion") @db.VarChar(100)

  movimientos transmision_movimientos[]

  @@index([tiendaId, venceEn], name: "idx_transmision_paquetes_tienda")
}

// De dónde salió cada minuto descontado de una transmisión (R7.3): plan del
// mes → paquete (el que vence primero) → excedente. "absorbido" = lo que no
// estaba cubierto ni confirmado: no se cobra (R7.6), lo asume la plataforma.
model transmision_movimientos {
  id            String    @id @default(uuid()) @db.Uuid
  tiendaId      String    @map("tienda_id") @db.Uuid
  transmisionId String    @map("transmision_id") @db.Uuid
  fuente        String    @db.VarChar(20) // plan | paquete | excedente | absorbido
  paqueteId     String?   @map("paquete_id") @db.Uuid
  periodo       String    @db.VarChar(7) // "YYYY-MM" del inicio de la función (Lima)
  minutos       Int
  fechaRegistro DateTime? @default(now()) @map("fecha_registro") @db.Timestamptz

  transmision evento_transmisiones  @relation(fields: [transmisionId], references: [id], onDelete: Cascade)
  paquete     transmision_paquetes? @relation(fields: [paqueteId], references: [id], onDelete: Restrict)

  @@index([tiendaId, periodo, fuente], name: "idx_transmision_movimientos_tienda")
  @@index([transmisionId], name: "idx_transmision_movimientos_transmision")
}

// Excedente confirmado de una transmisión (R7.6, R7.7): se cobra a mano con el
// siguiente pago de la tienda. autorizado → por_cobrar (al terminar, con lo
// realmente usado) → cobrado. "anulado" si al final no se usó.
model transmision_excedentes {
  id                 String    @id @default(uuid()) @db.Uuid
  tiendaId           String    @map("tienda_id") @db.Uuid
  transmisionId      String    @unique @map("transmision_id") @db.Uuid
  periodo            String    @db.VarChar(7)
  minutosAutorizados Int       @map("minutos_autorizados")
  minutos            Int       @default(0)
  monto              Decimal   @default(0) @db.Decimal(10, 2)
  estado             String    @default("autorizado") @db.VarChar(20) // autorizado | por_cobrar | cobrado | anulado
  autorizadoPor      String    @map("autorizado_por") @db.VarChar(100)
  autorizadoEn       DateTime  @map("autorizado_en") @db.Timestamptz
  cobradoEn          DateTime? @map("cobrado_en") @db.Timestamptz
  referenciaCobro    String?   @map("referencia_cobro") @db.VarChar(120)

  // Auditoría
  fechaRegistro        DateTime? @default(now()) @map("fecha_registro") @db.Timestamptz
  fechaActualizacion   DateTime? @map("fecha_actualizacion") @db.Timestamptz
  usuarioActualizacion String?   @map("usuario_actualizacion") @db.VarChar(100)

  transmision evento_transmisiones @relation(fields: [transmisionId], references: [id], onDelete: Cascade)

  @@index([tiendaId, periodo, estado], name: "idx_transmision_excedentes_tienda")
}

// ============================================
// TRANSMISIÓN: grabaciones y cargos (Fase 4)
// ============================================

// Una parte grabada de la transmisión. Cloudflare crea un video nuevo cada vez
// que la señal se reconecta después de 60 s (Fase 0), así que una transmisión
// puede tener varias partes. Borrar la entrada no borra estos videos.
model transmision_grabaciones {
  id               String    @id @default(uuid()) @db.Uuid
  tiendaId         String    @map("tienda_id") @db.Uuid
  transmisionId    String    @map("transmision_id") @db.Uuid
  videoId          String    @unique @map("video_id") @db.VarChar(64)
  orden            Int       @default(1)
  grabadaEn        DateTime  @map("grabada_en") @db.Timestamptz
  estado           String    @default("procesando") @db.VarChar(20) // procesando | lista | error | borrada
  duracionSeg      Int?      @map("duracion_seg")
  // MP4 descargable en el proveedor: sin_pedir | pendiente | lista | error
  mp4Estado        String    @default("sin_pedir") @map("mp4_estado") @db.VarChar(20)
  // Subtítulos automáticos en español (Premium: base del resumen con IA).
  // sin_pedir | pendiente | listo | error
  subtitulosEstado String    @default("sin_pedir") @map("subtitulos_estado") @db.VarChar(20)
  // Copia en R2 privado ("Guardar 1 año")
  r2Key            String?   @map("r2_key") @db.VarChar(300)
  r2Bytes          BigInt?   @map("r2_bytes")
  r2CopiadaEn      DateTime? @map("r2_copiada_en") @db.Timestamptz
  borradaEn        DateTime? @map("borrada_en") @db.Timestamptz

  fechaRegistro      DateTime? @default(now()) @map("fecha_registro") @db.Timestamptz
  fechaActualizacion DateTime? @map("fecha_actualizacion") @db.Timestamptz

  transmision evento_transmisiones @relation(fields: [transmisionId], references: [id], onDelete: Cascade)

  @@index([transmisionId], name: "idx_transmision_grabaciones_transmision")
  @@index([estado, mp4Estado], name: "idx_transmision_grabaciones_estado")
}

// Cargos manuales a la tienda distintos del excedente (hoy: "Guardar 1 año", S/ 50).
// Se cobran a mano con el siguiente pago (scripts/transmision-excedentes.js).
model transmision_cargos {
  id              String    @id @default(uuid()) @db.Uuid
  tiendaId        String    @map("tienda_id") @db.Uuid
  transmisionId   String    @map("transmision_id") @db.Uuid
  tipo            String    @db.VarChar(30) // guardar_anio
  monto           Decimal   @db.Decimal(10, 2)
  estado          String    @default("por_cobrar") @db.VarChar(20) // por_cobrar | cobrado | anulado
  autorizadoPor   String    @map("autorizado_por") @db.VarChar(100)
  autorizadoEn    DateTime  @map("autorizado_en") @db.Timestamptz
  cobradoEn       DateTime? @map("cobrado_en") @db.Timestamptz
  referenciaCobro String?   @map("referencia_cobro") @db.VarChar(120)

  fechaRegistro        DateTime? @default(now()) @map("fecha_registro") @db.Timestamptz
  fechaActualizacion   DateTime? @map("fecha_actualizacion") @db.Timestamptz
  usuarioActualizacion String?   @map("usuario_actualizacion") @db.VarChar(100)

  transmision evento_transmisiones @relation(fields: [transmisionId], references: [id], onDelete: Cascade)

  @@unique([transmisionId, tipo], name: "uq_transmision_cargo_tipo")
  @@index([tiendaId, estado], name: "idx_transmision_cargos_tienda")
}

// Retransmisión a Facebook o YouTube (Premium, R8.2): hasta 2 destinos. La clave
// se guarda cifrada (R9.4). La salida del proveedor solo emite en la ventana del
// evento (no durante la prueba): la maneja el job.
model transmision_destinos {
  id            String  @id @default(uuid()) @db.Uuid
  tiendaId      String  @map("tienda_id") @db.Uuid
  transmisionId String  @map("transmision_id") @db.Uuid
  plataforma    String  @db.VarChar(20) // facebook | youtube | otro
  url           String  @db.VarChar(500) // rtmp(s)://… del destino
  claveCifrada  String  @map("clave_cifrada") @db.Text
  salidaId      String? @map("salida_id") @db.VarChar(64)
  habilitada    Boolean @default(false)

  // Auditoría
  fechaRegistro        DateTime? @default(now()) @map("fecha_registro") @db.Timestamptz
  usuarioRegistro      String?   @map("usuario_registro") @db.VarChar(100)
  fechaActualizacion   DateTime? @map("fecha_actualizacion") @db.Timestamptz
  usuarioActualizacion String?   @map("usuario_actualizacion") @db.VarChar(100)

  transmision evento_transmisiones @relation(fields: [transmisionId], references: [id], onDelete: Cascade)

  @@index([transmisionId], name: "idx_transmision_destinos_transmision")
}
