# ============================================
# CONFIGURACIÓN DEL SERVIDOR
# ============================================
PORT=3000
NODE_ENV=development

# ============================================
# BASE DE DATOS - SUPABASE
# ============================================
# Transaction mode (port 6543) - para la app
DATABASE_URL="postgresql://user:password@host:6543/database?pgbouncer=true&connection_limit=${DB_POOL_SIZE}&pool_timeout=20"
# Conexión directa (port 5432) - solo para migraciones (prisma migrate)
DIRECT_URL="postgresql://user:password@host:5432/database"
# Conexiones simultáneas de Prisma hacia PgBouncer
# desarrollo: 1 | producción Supabase free: 5 | producción Supabase pro: 10
DB_POOL_SIZE=1

# ============================================
# AUTENTICACIÓN - SUPABASE JWT
# ============================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_SERVICE_KEY=your-service-role-key
JWT_AUDIENCE=authenticated

# ============================================
# RATE LIMITING
# ============================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ============================================
# CORS
# ============================================
CORS_ORIGIN=*
CORS_CREDENTIALS=false

# ============================================
# FRONTEND
# ============================================
FRONTEND_URL=http://localhost:5173

# ============================================
# PLATAFORMA — multi-tenant por subdominio
# Ej: zapateriaalonso.ecompyme.com → resuelve la tienda con slug "zapateriaalonso"
# Dejar vacío en local/desarrollo para usar el fallback por slug en path/query
# ============================================
PLATFORM_BASE_DOMAIN=ecompyme.com

# ============================================
# EMAIL - RESEND
# ============================================
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=onboarding@resend.dev
# En dev (free tier), los emails se redirigen a este email en vez del destinatario real
RESEND_DEV_TO_EMAIL=diegoarmando21.10@gmail.com

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=info
LOG_FORMAT=combined

# ============================================
# IA — GOOGLE GEMINI (edición de imágenes con Nano Banana, producto-imagenes)
# Obtener API key en https://aistudio.google.com/apikey — requiere billing habilitado
# en el proyecto de Google Cloud asociado para uso en producción.
# ============================================
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
# Circuit breaker de plataforma (todas las tiendas) para cortar el gasto ante abuso/errores.
# Vacío = sin tope (además de la cuota por tienda que ya bloquea por plan).
GEMINI_MAX_CALLS_DIA=
GEMINI_MAX_CALLS_MES=

# ============================================
# IA — KIE.AI (solo Studio, generar-ia de producto-imagenes ya no lo usa)
# Obtener API key en https://kie.ai/api-key
# ============================================
KIE_API_KEY=

# ============================================
# STUDIO — generador de imágenes IA sin persistencia permanente
# Bucket scratch (se crea automáticamente si no existe), separado del bucket
# de assets de tienda. Los archivos se limpian solos a los ~15 minutos.
# ============================================
STUDIO_SCRATCH_BUCKET=studio-scratch
