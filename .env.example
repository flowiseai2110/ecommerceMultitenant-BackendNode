# ============================================
# CONFIGURACIÓN DEL SERVIDOR
# ============================================
PORT=3000
NODE_ENV=development

# ============================================
# BASE DE DATOS - SUPABASE
# ============================================
# Transaction mode (port 6543) - para la app
DATABASE_URL="postgresql://user:password@host:6543/database?pgbouncer=true&connection_limit=${DB_POOL_SIZE}&pool_timeout=20"
# Conexión directa (port 5432) - solo para migraciones (prisma migrate)
DIRECT_URL="postgresql://user:password@host:5432/database"
# Conexiones simultáneas de Prisma hacia PgBouncer
# desarrollo: 1 | producción Supabase free: 5 | producción Supabase pro: 10
DB_POOL_SIZE=1

# ============================================
# AUTENTICACIÓN - SUPABASE JWT
# ============================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_SERVICE_KEY=your-service-role-key
JWT_AUDIENCE=authenticated

# ============================================
# RATE LIMITING
# ============================================
RATE_LIMIT_WINDOW_MS=900000
# Por IP real del visitante. Lecturas (GET/HEAD) y escrituras cuentan aparte.
RATE_LIMIT_READ_MAX=1000
RATE_LIMIT_MAX=100
# Tope de creación de pedidos por IP por ventana (anti bots que vacían stock
# con pedidos falsos — OWASP OAT-021). Un cliente real no necesita más.
RATE_LIMIT_CHECKOUT_MAX=5

# ============================================
# IP REAL DEL VISITANTE (ver kernel/http/client-ip.js)
# ============================================
# Saltos de proxy confiables. Railway = 2 (edge + proxy interno), verificado
# con GET /api/v1/debug/ip. No subirlo: permitiría falsificar la IP.
TRUST_PROXY_HOPS=2
# Expone GET /api/v1/debug/ip para el diagnóstico. Apagar al terminar.
DEBUG_CLIENT_IP=false
# Secreto compartido con el SSR del storefront (mismo valor en Vercel).
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SSR_API_KEY=
# Token para /api/v1/metrics (header X-Metrics-Key). Vacío = endpoint apagado (404).
METRICS_TOKEN=

# ============================================
# CORS
# ============================================
CORS_ORIGIN=*
CORS_CREDENTIALS=false

# ============================================
# FRONTEND
# ============================================
FRONTEND_URL=http://localhost:5173

# ============================================
# PLATAFORMA — multi-tenant por subdominio
# Ej: zapateriaalonso.ecompyme.com → resuelve la tienda con slug "zapateriaalonso"
# Dejar vacío en local/desarrollo para usar el fallback por slug en path/query
# ============================================
PLATFORM_BASE_DOMAIN=ecompyme.com
# Solo se usa si PLATFORM_BASE_DOMAIN está vacío (dev): links a tiendas por ruta /<slug>/...
STOREFRONT_URL=http://localhost:4200

# ============================================
# EMAIL - RESEND
# ============================================
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=onboarding@resend.dev
# En dev (free tier), los emails se redirigen a este email en vez del destinatario real
RESEND_DEV_TO_EMAIL=diegoarmando21.10@gmail.com

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=info
LOG_FORMAT=combined

# ============================================
# IA — GOOGLE GEMINI (edición de imágenes con Nano Banana, producto-imagenes)
# Obtener API key en https://aistudio.google.com/apikey — requiere billing habilitado
# en el proyecto de Google Cloud asociado para uso en producción.
# ============================================
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
# Circuit breaker de plataforma (todas las tiendas) para cortar el gasto ante abuso/errores.
# Vacío = sin tope (además de la cuota por tienda que ya bloquea por plan).
GEMINI_MAX_CALLS_DIA=
GEMINI_MAX_CALLS_MES=

# ============================================
# IA — KIE.AI (solo Studio, generar-ia de producto-imagenes ya no lo usa)
# Obtener API key en https://kie.ai/api-key
# ============================================
KIE_API_KEY=

# ============================================
# PASARELA DE PAGOS (PSP) — ver pasarela-de-pagos/ para el análisis
# ============================================
# Clave maestra (32 bytes) para cifrar las credenciales de pasarela de cada
# tienda en reposo (AES-256-GCM). Generar con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# NO rotar sin re-ingresar las credenciales de las tiendas (los secretos ya
# cifrados dejarían de descifrarse).
PAGOS_ENCRYPTION_KEY=
# Culqi — las llaves pk_/sk_ NO van aquí: cada tienda ingresa las suyas y se
# guardan cifradas en tienda_pasarela_config. Acá solo va lo global del proveedor.
CULQI_API_BASE_URL=https://api.culqi.com/v2
CULQI_TIMEOUT_MS=10000

# ============================================
# RESEÑAS — link firmado "califica tu compra" (WhatsApp tras la entrega)
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Rotarlo invalida los links ya enviados (no afecta reseñas existentes).
# ============================================
RESENAS_LINK_SECRET=
RESENAS_LINK_TTL_DIAS=60

# ============================================
# LIBRO DE RECLAMACIONES (docs/specs/libro-reclamaciones)
# LIBRO_LINK_SECRET firma el enlace a la constancia (mín. 32 caracteres aleatorios).
# LIBRO_IP_SALT: sal del hash de IP guardado en cada hoja (sin ella no se guarda).
# ============================================
LIBRO_LINK_SECRET=
LIBRO_LINK_TTL_DIAS=1095
LIBRO_RATE_LIMIT_MAX=5
LIBRO_IP_SALT=

# ============================================
# MINI BOOKING (docs/specs/mini-booking)
# RESERVAS_LINK_SECRET firma el link de seguimiento de cada reserva (mín. 32 caracteres aleatorios).
# RESERVAS_BUCKET_CAPTURAS: bucket PRIVADO de capturas de pago (lo crea docs/sql/mini_booking_setup.sql).
# ============================================
RESERVAS_LINK_SECRET=
RESERVAS_LINK_TTL_DIAS=400
RESERVAS_RATE_LIMIT_MAX=10
RESERVAS_BUCKET_CAPTURAS=pagos-capturas

# ============================================
# ALMACENAMIENTO PÚBLICO (catálogo, logos, banners, QR, widgets)
# supabase = bucket "tiendas" de Supabase Storage
# r2       = Cloudflare R2 servido por su CDN (requiere las R2_*)
# Lo privado/temporal (capturas de reservas, Studio) sigue en Supabase.
# ============================================
STORAGE_DRIVER=supabase
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Un bucket por base de datos: tiendas-dev / tiendas-prod
R2_BUCKET=tiendas-dev
# Dominio propio conectado al bucket: img-dev.ecompyme.com / img.ecompyme.com
R2_PUBLIC_URL=https://img-dev.ecompyme.com

# ============================================
# STUDIO — generador de imágenes IA sin persistencia permanente
# Bucket scratch (se crea automáticamente si no existe), separado del bucket
# de assets de tienda. Los archivos se limpian solos a los ~15 minutos.
# ============================================
STUDIO_SCRATCH_BUCKET=studio-scratch

# ============================================
# TELEMETRÍA - SENTRY (errores, trazas, logs)
# ============================================
# Vacío = Sentry desactivado. DSN en Sentry > Project Settings > Client Keys.
SENTRY_DSN=
# Por defecto NODE_ENV. Release por defecto: RAILWAY_GIT_COMMIT_SHA.
SENTRY_ENVIRONMENT=
# Fracción de requests trazadas (default: 0.2 en producción, 1.0 en desarrollo)
SENTRY_TRACES_SAMPLE_RATE=
# Nivel mínimo de Winston enviado a Sentry Logs
SENTRY_LOG_LEVEL=info
